# =============================================================================
# REQUIRED — core standalone secure exam platform
# =============================================================================

# PostgreSQL connection string used by Prisma. For Supabase, use the
# "Connection pooling" string (port 6543) for this value on Vercel — see
# docs/deployment-vercel-supabase.md.
DATABASE_URL="postgresql://user:password@localhost:5432/safe_exam_system?schema=public"

# Max connections this app's in-process pg pool opens PER serverless
# invocation. Keep this low on Vercel (default: 3) — Vercel can run many
# concurrent invocations, each with its own pool, and a high per-instance
# max can exhaust Supabase's pooled connection limit under concurrent
# exam traffic. See docs/concurrent-exam-pilot-capacity.md.
DATABASE_POOL_MAX=3

# NextAuth (v5) session signing secret. This app reads AUTH_SECRET — it does
# NOT read NEXTAUTH_SECRET. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Public base URL of this app, used to build the Canvas-facing
# redirect_uri/target_link_uri in /api/lti/login and /api/lti/config (must
# match what's registered in Canvas's Developer Key). NOT used for
# internal, same-app navigation — e.g. /api/lti/launch's post-launch
# redirect derives its destination from the incoming request's own origin
# instead, specifically so it can never point at a stale/previous
# deployment URL after a redeploy.
# The dev/start scripts run this app on port 3001 locally.
# This app does NOT currently read AUTH_URL/NEXTAUTH_URL or
# NEXT_PUBLIC_APP_URL from code — only APP_URL is consumed. They're listed
# here for forward-compatibility / convention; set APP_URL as the source of
# truth.
APP_URL=http://localhost:3001
# NEXT_PUBLIC_APP_URL=http://localhost:3001

# =============================================================================
# LOCAL DEVELOPMENT ONLY
# =============================================================================

# Only needed if running `prisma migrate dev` against a database that
# requires a separate shadow database. Not used by `prisma db push` or in
# production.
SHADOW_DATABASE_URL=

# =============================================================================
# OPTIONAL — Canvas / LTI 1.3 module (app works fully without this)
# =============================================================================

# Values from the Canvas Developer Key created for this tool.
LTI_CLIENT_ID=
LTI_DEPLOYMENT_ID=

# Canvas platform endpoints. These defaults work for canvas.instructure.com;
# self-hosted Canvas instances will have different URLs.
LTI_PLATFORM_ISSUER=https://canvas.instructure.com
LTI_PLATFORM_OIDC_AUTH=https://sso.canvaslms.com/api/lti/authorize_redirect
LTI_PLATFORM_JWKS=https://sso.canvaslms.com/api/lti/security/jwks
LTI_TOKEN_ENDPOINT=https://sso.canvaslms.com/ids/oidc/token

# RSA keypair used to sign/verify LTI JWTs. Three ways to provide each key —
# only one is needed, checked in this priority order: *_B64, then *_PATH,
# then the raw multiline var. See docs/deployment-vercel-supabase.md for
# generation instructions.
#
# Recommended for Vercel/deployment (base64-encoded, single line, avoids
# newline-mangling in dashboard env var UIs):
LTI_PRIVATE_KEY_B64=
LTI_PUBLIC_KEY_B64=
#
# Local development only — path to a PEM file on disk:
LTI_PRIVATE_KEY_PATH=
LTI_PUBLIC_KEY_PATH=
#
# Legacy/local fallback — raw PEM contents, preserving newlines as \n if kept
# on one line:
LTI_PRIVATE_KEY=
LTI_PUBLIC_KEY=

# Branding shown in the LTI tool config JSON (/api/lti/config). Optional —
# defaults are used if unset.
LTI_TOOL_NAME=
LTI_TOOL_DESCRIPTION=

# =============================================================================
# OPTIONAL — platform admin seed (see docs/platform-admin-onboarding.md)
# =============================================================================

# Set both to have `prisma/seed.ts` create/update a PLATFORM_ADMIN account.
# There is no fallback default password — if either var is missing, the
# seed skips platform admin creation and logs a safe message instead of
# failing.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# =============================================================================
# OPTIONAL — AI module (app works fully without this)
# =============================================================================

# Anthropic API key used for AI question generation and AI draft essay
# marking. Without it, those features return a safe "not configured" error;
# nothing else in the app is affected.
ANTHROPIC_API_KEY=

# =============================================================================
# OPTIONAL — Academic Integrity Network Evidence v1
# =============================================================================

# HMAC-SHA256 salt used to pseudonymise IP addresses for comparison. If unset,
# a random per-process salt is used (consistent within one server restart,
# changes on redeploy). Set to a stable random hex string in production so IP
# hashes are consistent across deployments and can be compared over time.
NETWORK_EVIDENCE_SALT=

# ── IP Geolocation (optional) ────────────────────────────────────────────────
#
# GEOLOCATION_PROVIDER controls whether IP-based location is looked up.
# The default is "none" — no external call, no IP address sent anywhere,
# country/region/city show "UNAVAILABLE" in the evidence report.
#
# Supported values:
#   none    (default) — no geolocation, UNAVAILABLE
#   ipapi   — https://ipapi.co — free tier, no API key required for basic use;
#             set GEOLOCATION_API_KEY for higher rate limits
#
# BEFORE setting a non-none provider in production, you MUST:
#   1. Review the provider's Terms of Service and data retention policy.
#   2. Determine if the provider must be listed as a privacy sub-processor
#      under your institution's privacy framework.
#   3. Update the student privacy notice to name the provider.
#   4. Obtain institutional approval for sending student IP addresses to
#      a third-party service.
# Do NOT enable a provider unless the above steps are complete.
GEOLOCATION_PROVIDER=none

# API key for the geolocation provider (optional for ipapi free tier).
# Required for paid plans or higher rate limits.
GEOLOCATION_API_KEY=

# Timeout for geolocation provider requests in milliseconds.
# Default: 2000ms. Must be short enough not to delay exam flow noticeably.
GEOLOCATION_TIMEOUT_MS=2000

# =============================================================================
# OPTIONAL — Exam Session Binding v1 (see docs/exam-session-binding-v1.md)
# =============================================================================

# HMAC-SHA256 secret used to hash session/device tokens, IP network
# prefixes, and user-agent strings for the exam session-binding feature.
# If unset, a random per-process secret is used (consistent within one
# server restart, changes on redeploy) — exactly like NETWORK_EVIDENCE_SALT
# above. Set a stable random string in production so hashes (and therefore
# device-continuity comparisons) remain consistent across deployments.
# Deliberately a DIFFERENT secret from AUTH_SECRET — never reuse it.
EXAM_BINDING_HMAC_SECRET=

# =============================================================================
# OPTIONAL — Evidence Frames v1 (AI camera integrity evidence)
# =============================================================================
# See docs/on-device-ai-integrity-detection-v1.md ("Evidence Frames v1") and
# docs/deployment-vercel-supabase.md for the full pre-activation checklist.
# Off by default (Exam.secureSettings.captureAiViolationEvidence); these
# variables only control WHERE captured frames are stored, not whether
# capture is enabled for any given exam.
#
# Supported EVIDENCE_STORAGE_PROVIDER values:
#   local_dev        (default outside production) — plain filesystem under
#                     .evidence-storage/ at the repo root. NEVER use in
#                     production — Vercel serverless instances do not share
#                     a persistent filesystem across invocations.
#   supabase_storage  — a private Supabase Storage bucket. This is the
#                       provider to use in production, since this app
#                       already deploys on Vercel + Supabase. Requires
#                       EVIDENCE_STORAGE_BUCKET, SUPABASE_URL (or
#                       NEXT_PUBLIC_SUPABASE_URL), and
#                       SUPABASE_SERVICE_ROLE_KEY below — fails closed
#                       (throws) if any is missing.
#   vercel_blob       — NOT YET IMPLEMENTED (throws until src/lib/evidenceStorage.ts
#                       is completed and the provider's SDK installed)
#   s3                — NOT YET IMPLEMENTED (same as above)
#
# Leaving this unset in production is safe — captureAiViolationEvidence
# simply cannot be enabled for any exam until a real provider is configured;
# every other feature is unaffected.
EVIDENCE_STORAGE_PROVIDER=local_dev

# Name of the private Supabase Storage bucket evidence frames are written
# to. Only used when EVIDENCE_STORAGE_PROVIDER=supabase_storage. The
# bucket MUST be created as private (not public) — see
# docs/deployment-vercel-supabase.md for exact setup steps. Objects are
# namespaced institution/{institutionId}/exam/{examId}/submission/{id}/
# event/{id}/{random}.{jpg|webp} — never a student's name or email.
EVIDENCE_STORAGE_BUCKET=safe-exam-evidence

# Supabase project URL. Only used server-side by the evidence storage
# adapter (never sent to the browser) when
# EVIDENCE_STORAGE_PROVIDER=supabase_storage. If your deployment already
# sets NEXT_PUBLIC_SUPABASE_URL for some other purpose, that value is
# used as a fallback when SUPABASE_URL itself is unset.
SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_URL=

# Supabase SERVICE ROLE key — grants full read/write access to Storage,
# bypassing bucket policies. Server-only: never prefix this with
# NEXT_PUBLIC_, never send it to the client, never log it. Only used when
# EVIDENCE_STORAGE_PROVIDER=supabase_storage. Find it in the Supabase
# dashboard under Project Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Tether Secure Client Foundation + Safe Exam Browser Compatibility v1 —
# hardening pass (see docs/secure-client-foundation-seb-v1.md and
# docs/migration-ledger.md). All server-only — never prefix any of these
# with NEXT_PUBLIC_, never log their values, never accept an equivalent
# value from a request/client.
# ---------------------------------------------------------------------------

# JSON object mapping every known SEB key-encryption key id to a 32-byte
# AES-256 key, hex-encoded (64 hex characters per key), e.g.
#   {"k1":"<64 hex chars>","k2":"<64 hex chars>"}
# Used by src/lib/secureClient/sebKeyEncryption.ts to encrypt/decrypt the
# raw Browser Exam Key / Config Key value. Missing or malformed = fails
# closed (adding a new SEB key throws; decrypting any existing key returns
# null) — there is no runtime-generated fallback. Keep every retired key
# id in this map so old ciphertext can still be decrypted after rotation;
# only remove one once every key encrypted under it has itself been
# re-encrypted or deleted. Generate a key with, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TETHER_SEB_KEY_ENCRYPTION_KEYS_JSON=

# Which key id in TETHER_SEB_KEY_ENCRYPTION_KEYS_JSON new SEB keys are
# encrypted with. Must be a key present in that JSON object.
TETHER_SEB_KEY_ENCRYPTION_ACTIVE_KEY_ID=

# Internal feature flag gating both SEB_OPTIONAL and SEB_REQUIRED delivery
# modes — see src/lib/secureClientAvailability.ts. No real Safe Exam
# Browser client has been validated against this backend yet, so both
# modes remain experimental until that validation happens (see "Known
# limitations" in docs/secure-client-foundation-seb-v1.md). Never true in
# Production regardless of this flag — Production deployment is detected
# via VERCEL_ENV, not NODE_ENV (NODE_ENV is "production" for BOTH Preview
# and Production builds on Vercel).
TETHER_SEB_EXPERIMENTAL_ENABLED=false

# Comma-separated institution slugs authorised to select SEB_REQUIRED
# (SEB_OPTIONAL only needs TETHER_SEB_EXPERIMENTAL_ENABLED above — this
# additional allowlist applies to SEB_REQUIRED only, since an exam that
# REQUIRES an unvalidated client is the higher-risk case). Ignored unless
# TETHER_SEB_EXPERIMENTAL_ENABLED=true. Never allowed in Production under
# any combination of these flags.
TETHER_SEB_REQUIRED_ALLOWED_INSTITUTION_SLUGS=

# ---------------------------------------------------------------------------
# Tether launch/install flow v1 — see
# src/lib/secureClientAvailability.ts and src/lib/secureClientStartGate.ts.
# All server-only — never prefix any of these with NEXT_PUBLIC_, never log
# their values, never accept an equivalent value from a request/client.
# ---------------------------------------------------------------------------

# Ed25519 signing key material for the signed, short-lived, single-use
# launch manifest issued to Tether Secure Browser (and to Safe Exam
# Browser/the mock client, which reuse the exact same manifest
# infrastructure) — see src/lib/secureClient/secureLaunchManifest.ts and
# src/lib/secureClientRunner.ts. PEM-encoded. Generate a pair with:
#   node -e "const{generateKeyPairSync}=require('crypto');const{publicKey,privateKey}=generateKeyPairSync('ed25519');console.log(privateKey.export({type:'pkcs8',format:'pem'}).toString());console.log(publicKey.export({type:'spki',format:'pem'}).toString());"
TETHER_SECURE_CLIENT_SIGNING_PRIVATE_KEY=
TETHER_SECURE_CLIENT_SIGNING_PUBLIC_KEY=

# Key id embedded in every issued manifest, so a future key rotation can
# tell which public key to verify a given manifest against. Defaults to
# "dev-key-1" if unset — only needs to be set explicitly once real key
# rotation is in use.
TETHER_SECURE_CLIENT_SIGNING_KEY_ID=

# Kill-switch only — TETHER_CLIENT_REQUIRED is available by default in
# EVERY environment, including Production, now that Tether Secure Browser
# is the first-party, signed production client (this is a deliberate
# reversal of the old "cannot be selected until a signed production
# client is available" gate). Set to "true" to disable it everywhere,
# e.g. for an emergency rollback. Leave unset/false in normal operation.
TETHER_CLIENT_REQUIRED_DISABLED=false

# Development/Preview bypass (product contract: "Normal-browser student
# exam access remains available only as a controlled local/Preview
# development bypass"). Governs whether a student may proceed into a
# TETHER_CLIENT_REQUIRED exam's content via an ordinary browser instead
# of being redirected to the Tether launch page — completely separate
# from TETHER_CLIENT_REQUIRED_DISABLED above. Requires BOTH this flag and
# the institution allowlist below. Never available in Production or an
# unrecognised deployment environment, regardless of either value.
TETHER_SECURE_CLIENT_BYPASS_ENABLED=false

# Comma-separated institution slugs authorised to use the development
# bypass above. Ignored unless TETHER_SECURE_CLIENT_BYPASS_ENABLED=true.
TETHER_SECURE_CLIENT_BYPASS_ALLOWED_INSTITUTION_SLUGS=

# Tether System Check and Exam Readiness v1 — see
# docs/tether-system-check-v1.md. OFF disables the whole feature (every
# check still runs client-side for the student's own benefit, but
# nothing is required); WARN (the safe default — missing/malformed
# configuration always falls back to this) shows the latest result and
# encourages a current check without ever blocking exam start; REQUIRE
# blocks a FINAL EXAMINATION's start route until a current READY or
# READY_WITH_WARNINGS system-check record exists. Even in REQUIRE mode,
# the real exam-start preflight and verified secure-client checks always
# run again — this setting can never authorise exam content by itself,
# and never affects non-final assessments.
TETHER_SYSTEM_CHECK_MODE=WARN

# How many hours a stored system-check result stays current before it is
# treated as expired. Defaults to 24 if unset or not a positive number.
TETHER_SYSTEM_CHECK_VALIDITY_HOURS=24

# The minimum Tether Secure Browser version a system check will report as
# supported (Check C). An older reported client version is BLOCKED, never
# marked ready. Defaults to "1.5.0" (this release) if unset — versions
# before 1.5.0 (specifically, 1.4.0) shipped a single globally-embedded
# attestation private key and have been WITHDRAWN; see
# docs/tether-system-check-v1.md, "Secure Client Attestation v2" — they
# must not be distributed regardless of this setting.
TETHER_MINIMUM_SUPPORTED_VERSION=1.5.0

# Secure Client Attestation v2 — see docs/tether-system-check-v1.md,
# "Compatibility and rollout" and "Immutable per-session attestation
# requirement" for the full truth table. Single central resolver
# (src/lib/tetherAttestationConfig.ts) — replaces the two independent
# booleans this file used to document (TETHER_LEGACY_ATTESTATION_ALLOWED
# / TETHER_REQUIRE_EXAM_SESSION_V2), neither of which was ever wired into
# a real enforcement decision.
#
# IMPORTANT: this value is read ONLY when a NEW SecureClientSession is
# first created (getOrCreateSessionCore in secureClientRunner.ts) — the
# resolved mode is snapshotted onto that session's own
# `attestationRequirement` column and never re-read from this variable
# again for that session. Changing this value has NO effect on any
# already-in-progress session's access contract; it only affects newly
# created ones. There is no client-version-based grandfathering of any
# kind — a pre-Preview safety pass removed that mechanism entirely after
# finding it was a client-controllable downgrade path (the legacy
# attestation route writes SecureClientSession.clientVersion completely
# unsigned, straight from the renderer-supplied request body).
#
#   LEGACY (safe default; any unrecognised value also falls back here):
#     new sessions snapshot LEGACY — the existing, unmodified
#     recordAttestation() flow
#     (POST /api/secure-client/sessions/[sessionId]/attestation) remains
#     the SOLE determinant of that session's verified status. v2
#     EXAM_SESSION evidence is still recorded when available, but has
#     zero effect on access — no student can be locked out by this
#     setting merely existing.
#   DUAL: new sessions snapshot DUAL — BOTH the legacy VERIFIED status
#     AND genuine installation-bound v2 evidence are required,
#     unconditionally, for that session. A client physically unable to
#     produce v2 evidence (too old to have the capability at all) simply
#     cannot complete a DUAL-snapshotted session — there is no
#     grandfathering by any reported client version.
#   V2_REQUIRED: new sessions snapshot V2_REQUIRED — only genuine,
#     installation-bound v2 EXAM_SESSION evidence verifies that session;
#     legacy-only attestation is rejected outright. Requires every
#     student to already be on a v1.5.0+ Tether Secure Browser. Do not
#     enable in Production until DUAL has been run through a full pilot
#     first — see "First-pilot settings" below.
TETHER_EXAM_ATTESTATION_MODE=LEGACY

# Secure Client Attestation v2 — multi-device support. How many
# installations may be simultaneously ACTIVE for the same student (a
# replacement device before an original fails, or before revoking an old
# one). Registering beyond this limit is rejected (LIMIT_REACHED) — it
# never silently revokes an existing device. Defaults to 2 if unset;
# clamped to [1, 5] against a malformed value.
TETHER_MAX_ACTIVE_INSTALLATIONS_PER_USER=2

# ---------------------------------------------------------------------------
# Tether Secure Exam Recovery and Resilient Autosave v1 — see
# docs/tether-secure-resume-recovery-v1.md. All resolved by
# src/lib/tetherRecoveryConfig.ts (single central resolver per variable,
# same convention as TETHER_EXAM_ATTESTATION_MODE above); every value is
# clamped against a malformed/out-of-range entry, never used raw.
# ---------------------------------------------------------------------------

# How long (minutes) a student may keep answering — with Tether
# restrictions/display/camera enforcement still fully active — after their
# secure-client session's heartbeat goes overdue, before the server stops
# trusting the existing verified session and requires a fresh crash/
# relaunch-style recovery (fresh SecureClientSession + fresh EXAM_SESSION
# attestation). Conservative default: 10 minutes. Clamped to [2, 30].
TETHER_OFFLINE_CONTINUE_MINUTES=10

# Ceiling (seconds) of the client's own bounded-exponential-backoff
# autosave retry loop (src/lib/pendingSaveQueue.ts) — a client-side pacing
# hint only; the server never rejects a save for arriving "late" on this
# basis. Conservative default: 60 seconds. Clamped to [10, 300].
TETHER_AUTOSAVE_RETRY_MAX_SECONDS=60

# How long (hours) an unsent, locally-queued answer draft may remain in
# the student's browser (IndexedDB) before being treated as stale and
# discarded — a client-side retention/privacy bound, not something the
# server enforces directly. Conservative default: 72 hours (3 days).
# Clamped to [1, 168] (1 hour to 1 week).
TETHER_PENDING_SAVE_RETENTION_HOURS=72

# The DEFAULT heartbeat cadence (seconds) suggested to a client before any
# per-exam policy is known. The real, authoritative interval for an
# in-progress attempt is always the per-attempt FROZEN
# secureClientHeartbeatIntervalSeconds inside that attempt's own
# secureClientPolicySnapshotJson (already configurable per exam,
# [15, 120]s) — this env var never overrides that once an attempt has
# started. Reuses the same bounds/default as that existing per-exam
# setting. Clamped to [15, 120].
TETHER_HEARTBEAT_INTERVAL_SECONDS=30
