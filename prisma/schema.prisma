generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  LECTURER
  STUDENT
  PLATFORM_ADMIN
}

enum QuestionType {
  MULTIPLE_CHOICE
  SHORT_ANSWER
  ESSAY
}

enum SubmissionStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

enum IntegrityEventType {
  FULLSCREEN_EXIT
  WINDOW_BLUR
  WINDOW_FOCUS_RETURN
  COPY_ATTEMPT
  PASTE_ATTEMPT
  RIGHT_CLICK_ATTEMPT
  DEVTOOLS_SUSPECTED
  NETWORK_OFFLINE
  NETWORK_ONLINE
  AUTOSAVE_FAILED
  TIMER_EXPIRED
  SUBMIT_AFTER_DEADLINE
  MANUAL_WARNING
  // Camera Monitoring v1 (additive — see docs/secure-exam-threat-model.md)
  CAMERA_PERMISSION_GRANTED
  CAMERA_PERMISSION_DENIED
  CAMERA_STARTED
  CAMERA_STOPPED
  CAMERA_UNAVAILABLE
  CAMERA_HEARTBEAT_MISSED
  CAMERA_PRECHECK_FAILED
  // Browser-Level Friction v1 (additive)
  KEYBOARD_SHORTCUT_BLOCKED
  FULLSCREEN_FORCED_RETURN
  // Optional Student Verification + On-Device AI Camera Integrity
  // Detection v1 (additive — see
  // docs/on-device-ai-integrity-detection-v1.md). All AI signals are
  // metadata-only: no image, frame, or video data is ever stored.
  STUDENT_VERIFICATION_CONFIRMED
  POSSIBLE_PHONE_VISIBLE
  POSSIBLE_SECOND_PERSON_VISIBLE
  NO_PERSON_VISIBLE
  CAMERA_VIEW_BLOCKED
  CAMERA_TOO_DARK
  AI_CAMERA_CHECK_UNAVAILABLE
  // Corrective pass v1.2.2, Task 8 (additive) — a resource/capture-level
  // camera interruption (e.g. another application holding the camera),
  // reported separately from NO_PERSON_VISIBLE so a capture failure is
  // never misclassified as confirmed face absence. See
  // classifyCameraStreamHealth in src/lib/cameraIntegrityDetection.ts.
  CAMERA_STREAM_UNAVAILABLE
  // Camera integrity reliability pass (additive) — the "stable recovery"
  // event, mirroring the existing SCREEN_SHARE_RESTORED /
  // DISPLAY_POLICY_RESTORED pattern: fired once when a CONFIRMED sustained
  // no-person episode resolves back to several consecutive, confidently
  // visible frames. See resolveCameraIntegrityState in
  // src/lib/cameraIntegrityDetection.ts. Neutral wording only — never
  // implies the earlier absence was misconduct.
  CAMERA_VISIBILITY_RESTORED
  // One-Question-At-A-Time Exam Delivery v1 (additive — see
  // docs/one-question-delivery-v1.md).
  QUESTION_NAVIGATED_NEXT
  QUESTION_NAVIGATED_PREVIOUS
  QUESTION_BACK_NAVIGATION_BLOCKED
  // Question Navigator v1 (additive — see docs/question-navigator-v1.md).
  // Only used when allowQuestionJumping is true and a request actually
  // jumps more than one position; adjacent Next/Previous moves keep
  // using the existing QUESTION_NAVIGATED_NEXT/PREVIOUS types above.
  QUESTION_NAVIGATED_DIRECT
  QUESTION_DIRECT_NAVIGATION_BLOCKED
  // Controlled AI Brainstorming Assistance v1 (additive — see
  // docs/controlled-ai-brainstorming-assistance-v1.md). Neutral,
  // operational events only — this is an ALLOWED assessment resource,
  // never treated as misconduct, so none of these carry any integrity
  // risk weight (see severityFor in src/lib/secureExam.ts).
  AI_ASSISTANCE_USED
  AI_ASSISTANCE_REQUEST_BLOCKED
  AI_ASSISTANCE_LIMIT_REACHED
  AI_ASSISTANCE_RESPONSE_REGENERATED
  // Hardening v1.1 — a genuine provider/parsing failure (see
  // AiAssistanceInteraction.status "FAILED" above), distinct from a
  // policy-driven decline (AI_ASSISTANCE_REQUEST_BLOCKED) or a graceful
  // safe-fallback (still AI_ASSISTANCE_USED). Still INFO severity/zero
  // risk weight like every other AI_ASSISTANCE_* event — a provider
  // outage is never evidence about the student.
  AI_ASSISTANCE_REQUEST_FAILED
  // Screen-share Evidence Mode v1 (additive) — see
  // docs/screen-share-evidence-v1.md. Lifecycle and evidence-capture
  // signals for an optional, opt-in whole-screen-sharing requirement.
  // These are REVIEW SIGNALS, never automatic misconduct findings — see
  // severityFor() in src/lib/secureExam.ts, which keeps a single
  // interruption at a moderate (not severe) weight and never assigns
  // risk to permitted/informational events.
  SCREEN_SHARE_STARTED
  SCREEN_SHARE_PERMISSION_DENIED
  SCREEN_SHARE_UNAVAILABLE
  SCREEN_SHARE_SURFACE_REJECTED
  SCREEN_SHARE_INTERRUPTED
  SCREEN_SHARE_RESTORED
  SCREEN_SHARE_EVIDENCE_CAPTURED
  SCREEN_SHARE_EVIDENCE_CAPTURE_FAILED
}

enum IntegritySeverity {
  INFO
  LOW
  MEDIUM
  HIGH
}

enum CanvasPassbackStatus {
  NOT_READY
  PENDING
  SENT
  FAILED
  SKIPPED
}

// Course, Enrolment, Exam Assignment, Scheduling v1 — see
// docs/course-enrolment-and-exam-assignment.md.
enum CourseRole {
  STUDENT
  LECTURER
}

enum ExamAssignmentMode {
  COURSE
  SELECTED_STUDENTS
}

// Multi-Tenant Architecture v1 — see docs/multi-tenant-migration.md.
model Institution {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  domain       String?
  plan         String        @default("pilot")
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  users        User[]
  exams        Exam[]
  ltiPlatforms LtiPlatform[]
  courses      Course[]
}

// Platform Admin Onboarding v2 — minimal audit trail for platform-admin
// actions (institution create/update, lecturer invite). See
// docs/platform-admin-onboarding.md. actorId/institutionId are SetNull
// on delete so a log entry survives the actor or institution being
// removed, rather than cascading away the audit trail.
model PlatformAuditLog {
  id            String   @id @default(cuid())
  actorId       String?
  actor         User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action        String
  targetType    String
  targetId      String?
  institutionId String?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([actorId])
  @@index([institutionId])
  @@index([action])
  @@index([createdAt])
}

model User {
  id                String           @id @default(cuid())
  name              String
  email             String           @unique
  passwordHash      String
  role              Role
  createdAt         DateTime         @default(now())
  examsCreated      Exam[]           @relation("ExamCreator")
  submissions       Submission[]
  integrityEvents   IntegrityEvent[] @relation("IntegrityEventStudent")
  resolvedEvents    IntegrityEvent[] @relation("IntegrityEventResolver")
  networkEvidence   NetworkEvidence[] @relation("NetworkEvidenceStudent")
  // canvasUserId is unique per institution, not globally — a self-hosted
  // Canvas instance at a different institution could otherwise collide
  // with another institution's user id. See docs/multi-tenant-migration.md.
  canvasUserId      String?
  canvasCourseIds   String[]         @default([])
  questionBanks     QuestionBank[]
  // Multi-Tenant Architecture v1 (additive, nullable — see
  // docs/multi-tenant-migration.md). Nullable at the DB level; application
  // code treats it as required via src/lib/institutionScope.ts.
  institutionId     String?
  institution       Institution?     @relation(fields: [institutionId], references: [id])
  // Platform Admin Onboarding v2 — see docs/platform-admin-onboarding.md.
  platformAuditLogs PlatformAuditLog[]
  // Course, Enrolment, Exam Assignment, Scheduling v1 — see
  // docs/course-enrolment-and-exam-assignment.md.
  courseEnrollments CourseEnrollment[]
  examAssignments   ExamAssignment[]
  // Assessment Operations v1 (additive) — see
  // docs/assessment-operations-v1.md. An optional institution-issued
  // student ID (e.g. a roll number or SIS ID), distinct from this row's
  // database id and never used as a login credential. Not unique-
  // constrained at the DB level in v1 — see that doc for why uniqueness
  // is deferred to a future release rather than enforced here.
  institutionStudentId String?

  // Answer Similarity Review + Oral Verification v1 (additive) — see
  // docs/answer-similarity-review-v1.md and
  // docs/oral-verification-workflow-v1.md.
  reviewedSimilarityMatches  SubmissionSimilarityMatch[] @relation("SimilarityMatchReviewer")
  oralVerificationsRequested OralVerification[]          @relation("OralVerificationRequestedBy")
  oralVerificationsCompleted OralVerification[]          @relation("OralVerificationCompletedBy")

  // AI-Use Answer Review v1 (additive) — see docs/ai-use-answer-review-v1.md.
  aiUseReviewAnalysesRequested AiUseReviewAnalysis[] @relation("AiUseReviewRequestedBy")
  reviewedAiUseReviewSignals   AiUseReviewSignal[]    @relation("AiUseReviewSignalReviewer")

  // Exam Session Binding + Time Anomaly Review v1 (additive) — see
  // docs/exam-session-binding-v1.md and docs/time-anomaly-review-v1.md.
  examAttemptSessions              ExamAttemptSession[]      @relation("ExamAttemptSessionUser")
  reviewedSessionIntegritySignals  SessionIntegritySignal[]  @relation("SessionIntegritySignalReviewer")
  timingAnalysesRequested          TimingAnalysis[]          @relation("TimingAnalysisRequestedBy")
  reviewedTimingIntegritySignals   TimingIntegritySignal[]   @relation("TimingIntegritySignalReviewer")

  // Exam Design Policy + Evidence Review v1 (additive) — see
  // docs/evidence-review-workflow-v1.md.
  reviewedIntegrityEvents      IntegrityEvent[]                @relation("IntegrityEventReviewer")
  integrityReviewComments      IntegrityReviewComment[]        @relation("IntegrityReviewCommentAuthor")
  integrityReviewStatusChanges IntegrityReviewStatusHistory[]  @relation("IntegrityReviewStatusChanger")

  // Controlled AI Brainstorming Assistance v1 (additive) — see
  // docs/controlled-ai-brainstorming-assistance-v1.md.
  aiAssistanceInteractions AiAssistanceInteraction[]

  // Cohort-Level Collusion Detection and Integrity Graph v1 (additive) —
  // see docs/cohort-collusion-graph-v1.md.
  cohortCollusionAnalysesRequested CohortCollusionAnalysis[] @relation("CohortCollusionAnalysisRequestedBy")
  reviewedCollusionClusters        CollusionCluster[]        @relation("CollusionClusterReviewer")

  // Tether Secure Client Foundation + Safe Exam Browser Compatibility v1
  // (additive, opt-in) — see docs/secure-client-foundation-seb-v1.md.
  createdSecureClientConfigurations   SecureClientConfiguration[] @relation("SecureClientConfigCreatedBy")
  activatedSecureClientConfigurations SecureClientConfiguration[] @relation("SecureClientConfigActivatedBy")
  revokedSecureClientConfigurations   SecureClientConfiguration[] @relation("SecureClientConfigRevokedBy")
  createdSebAllowedExamKeys           SebAllowedExamKey[]         @relation("SebAllowedExamKeyCreatedBy")
  issuedSecureClientRecoveryGrants    SecureClientRecoveryGrant[] @relation("SecureClientRecoveryGrantIssuedBy")

  // Tether System Check and Exam Readiness v1 (additive) — see
  // docs/tether-system-check-v1.md.
  tetherSystemCheckRuns TetherSystemCheckRun[]
  // Corrective pass — first-time SYSTEM_CHECK secure-client verification.
  systemCheckSecureClientVerifications SystemCheckSecureClientVerification[]
  // Secure Client Attestation v2 — see docs/tether-system-check-v1.md.
  tetherClientInstallations TetherClientInstallation[]
  // Pre-Preview safety pass — see "Single-use registration challenges".
  tetherInstallationRegistrationChallenges TetherInstallationRegistrationChallenge[]

  @@unique([institutionId, canvasUserId])
  @@index([institutionId])
}

model Exam {
  id              String           @id @default(cuid())
  title           String
  description     String?
  durationMins    Int
  published       Boolean          @default(false)
  startsAt        DateTime?
  endsAt          DateTime?
  createdById     String
  createdBy       User             @relation("ExamCreator", fields: [createdById], references: [id])
  questions       Question[]
  submissions     Submission[]
  integrityEvents  IntegrityEvent[]
  ltiExamLinks     LtiExamLink[]
  networkEvidence  NetworkEvidence[]
  // On-Device AI Camera Integrity Detection v1 — Evidence Frames
  // (additive, opt-in). See docs/on-device-ai-integrity-detection-v1.md.
  evidenceAssets   IntegrityEvidenceAsset[]
  // Secure Exam Mode v1 settings (see src/lib/secureExam.ts for shape/defaults).
  // A single JSON column rather than ~10 booleans/ints, since this app has no
  // other multi-flag settings model and these are read/written together.
  secureSettings  Json?
  createdAt       DateTime         @default(now())
  // Multi-Tenant Architecture v1 (additive, nullable) — see
  // docs/multi-tenant-migration.md.
  institutionId   String?
  institution     Institution?     @relation(fields: [institutionId], references: [id])
  // Student Onboarding and Exam Access v1 (additive) — see
  // docs/student-onboarding-and-exam-access.md. Never store the plaintext
  // code; accessCodeRequired is a separate flag (not just "hash is set")
  // so clearing the code is an explicit, unambiguous action.
  accessCodeHash     String?
  accessCodeRequired Boolean       @default(false)
  // Assessment Lifecycle v1: exam-level marks release. Students only see
  // score/feedback data after this is set by the owning lecturer/admin.
  marksReleasedAt    DateTime?
  marksReleasedById  String?

  // Course, Enrolment, Exam Assignment, Scheduling v1 — see
  // docs/course-enrolment-and-exam-assignment.md. courseId is nullable:
  // a null value means this is a legacy institution-wide exam, which
  // remains visible to every student in the institution exactly as
  // before this feature — see that doc for the full legacy-visibility
  // rule and its test coverage.
  courseId       String?
  course         Course?            @relation(fields: [courseId], references: [id])
  assignmentMode ExamAssignmentMode @default(COURSE)
  assignments    ExamAssignment[]
  // Scheduled availability window — distinct from the pre-existing
  // startsAt/endsAt (which historically doubled as both "exam metadata"
  // and "availability window"). availableFrom/availableUntil are the new,
  // explicit scheduling fields; both remain optional so unset exams have
  // no window restriction (see docs/course-enrolment-and-exam-assignment.md).
  availableFrom    DateTime?
  availableUntil   DateTime?

  // Question Pools v1 (additive, opt-in) — see docs/question-pools-v1.md.
  questionPools QuestionPool[]

  // Answer Similarity Review v1 (additive) — see
  // docs/answer-similarity-review-v1.md.
  similarityAnalyses SubmissionSimilarityAnalysis[]

  // AI-Use Answer Review v1 (additive) — see docs/ai-use-answer-review-v1.md.
  aiUseReviewAnalyses AiUseReviewAnalysis[]

  // Exam Session Binding + Time Anomaly Review v1 (additive) — see
  // docs/time-anomaly-review-v1.md.
  timingAnalyses TimingAnalysis[]

  // Cohort-Level Collusion Detection and Integrity Graph v1 (additive) —
  // see docs/cohort-collusion-graph-v1.md. Consumes the outputs of the
  // similarity/timing/session-binding features above; does not replace
  // or duplicate them.
  cohortCollusionAnalyses CohortCollusionAnalysis[]

  // Tether Secure Client Foundation + Safe Exam Browser Compatibility v1
  // (additive, opt-in) — see docs/secure-client-foundation-seb-v1.md. The
  // web platform remains fully functional without any of this — see
  // deliveryMode default STANDARD_WEB in src/lib/secureClientPolicy.ts.
  secureClientConfigurations   SecureClientConfiguration[]
  secureClientLaunchManifests  SecureClientLaunchManifest[]
  secureClientSessions         SecureClientSession[]

  @@index([institutionId])
  @@index([courseId])
}

// Question Pools v1 (additive, opt-in) — see docs/question-pools-v1.md.
// A lecturer-defined group of interchangeable questions within one exam;
// each student attempt draws `drawCount` questions at random from each
// pool at attempt start (see buildSelectedQuestionIds() in
// src/lib/questionDelivery.ts). Questions never assigned to a pool
// (Question.questionPoolId null) are always included for every student —
// see docs/question-pools-v1.md, "Unpooled questions."
model QuestionPool {
  id          String     @id @default(cuid())
  examId      String
  exam        Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  name        String
  description String?
  // Number of questions to draw from this pool per attempt. Null (or <= 0)
  // means "include every question in this pool" — see
  // docs/question-pools-v1.md. If greater than the number of questions
  // actually in the pool, every available question is included instead
  // of erroring.
  drawCount Int?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  questions Question[]

  @@index([examId])
}

model Question {
  id            String       @id @default(cuid())
  examId        String
  exam          Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  type          QuestionType
  text          String
  options       Json?
  correctAnswer String?
  points        Int          @default(1)
  order         Int          @default(0)
  // Question Pools v1 (additive, opt-in, nullable) — see
  // docs/question-pools-v1.md. Null means "not in any pool" — always
  // included for every student regardless of pool settings.
  questionPoolId String?
  questionPool   QuestionPool? @relation(fields: [questionPoolId], references: [id], onDelete: SetNull)
  answers       Answer[]
  // Answer Similarity Review v1 (additive) — see
  // docs/answer-similarity-review-v1.md.
  similarityMatches SubmissionSimilarityMatch[]
  // AI-Use Answer Review v1 (additive) — see docs/ai-use-answer-review-v1.md.
  aiUseReviewSignals AiUseReviewSignal[]
  // Exam Session Binding + Time Anomaly Review v1 (additive) — see
  // docs/exam-session-binding-v1.md.
  answerActivityEvents AnswerActivityEvent[]
  // Question Navigator v1 (additive, opt-in) — see
  // docs/question-navigator-v1.md.
  submissionQuestionStates SubmissionQuestionState[]
  // Controlled AI Brainstorming Assistance v1 (additive, opt-in) — see
  // docs/controlled-ai-brainstorming-assistance-v1.md.
  aiAssistanceInteractions AiAssistanceInteraction[]

  // Answer-Development Provenance v1 (additive, opt-in) — see
  // docs/answer-development-provenance-v1.md.
  developmentVersions AnswerDevelopmentVersion[]
  developmentEvents   AnswerDevelopmentEvent[]
  developmentArtifacts AnswerDevelopmentArtifact[]
  codeExecutionEvents  CodeExecutionEvent[]
}

// Answer Similarity Review v1 (additive) — see
// docs/answer-similarity-review-v1.md. One row per analysis run of one
// exam's submitted cohort. Status/risk fields are validated strings, not
// Prisma enums, following the IntegrityEvidenceAsset convention (plain
// String columns keep the production migration purely additive with no
// enum-alteration risk); validation lives in src/lib/answerSimilarity.ts.
// Everything here is a REVIEW SIGNAL for a human lecturer — never an
// automatic misconduct finding, never a grade input.
model SubmissionSimilarityAnalysis {
  id     String @id @default(cuid())
  examId String
  exam   Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)
  // Set when the run was scoped to a single submission; null for a
  // whole-exam run (the v1 default).
  submissionId     String?
  status           String    @default("PENDING") // PENDING | PROCESSING | COMPLETE | FAILED
  overallRisk      String    @default("NONE") // NONE | LOW | MEDIUM | HIGH
  analysedAt       DateTime?
  algorithmVersion String
  summaryJson      Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  matches          SubmissionSimilarityMatch[]

  @@index([examId])
  @@index([status])
}

// One flagged pair (source vs compared submission, optionally scoped to
// one question) with an explainable signal — see
// docs/answer-similarity-review-v1.md. Pair ordering is canonical
// (sourceSubmissionId < comparedSubmissionId lexicographically) so A-vs-B
// and B-vs-A never produce duplicate rows.
model SubmissionSimilarityMatch {
  id                   String                       @id @default(cuid())
  analysisId           String
  analysis             SubmissionSimilarityAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  sourceSubmissionId   String
  sourceSubmission     Submission                   @relation("SimilarityMatchSource", fields: [sourceSubmissionId], references: [id], onDelete: Cascade)
  comparedSubmissionId String
  comparedSubmission   Submission                   @relation("SimilarityMatchCompared", fields: [comparedSubmissionId], references: [id], onDelete: Cascade)
  questionId           String?
  question             Question?                    @relation(fields: [questionId], references: [id], onDelete: SetNull)
  signalType           String // IDENTICAL_SHORT_ANSWER | HIGH_TEXT_SIMILARITY | SAME_WRONG_MCQ_PATTERN
  score                Float
  matchedDetailJson    Json?
  reviewStatus         String                       @default("NEEDS_REVIEW") // NEEDS_REVIEW | REVIEWED_NO_CONCERN | REVIEWED_CONCERN_REMAINS | ESCALATED | RESOLVED
  reviewedAt           DateTime?
  reviewedById         String?
  reviewedBy           User?                        @relation("SimilarityMatchReviewer", fields: [reviewedById], references: [id])
  reviewNote           String?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  @@index([analysisId])
  @@index([sourceSubmissionId])
  @@index([comparedSubmissionId])
  @@index([questionId])
  @@index([reviewStatus])
}

// Oral Verification Workflow v1 (additive) — see
// docs/oral-verification-workflow-v1.md. Only ever created by an
// explicit lecturer action ("Require oral verification") — never
// automatically. lecturerNotes are private to staff and never exposed to
// any student-facing route.
model OralVerification {
  id                     String     @id @default(cuid())
  submissionId           String
  submission             Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  requestedById          String
  requestedBy            User       @relation("OralVerificationRequestedBy", fields: [requestedById], references: [id])
  status                 String     @default("REQUIRED") // NOT_REQUIRED | REQUIRED | SCHEDULED | COMPLETED_NO_CONCERN | COMPLETED_CONCERN_REMAINS | CANCELLED
  reason                 String
  scheduledAt            DateTime?
  completedAt            DateTime?
  completedById          String?
  completedBy            User?      @relation("OralVerificationCompletedBy", fields: [completedById], references: [id])
  outcome                String?
  lecturerNotes          String?
  generatedQuestionsJson Json?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  @@index([submissionId])
  @@index([status])
}

model Submission {
  id          String           @id @default(cuid())
  examId      String
  exam        Exam             @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId   String
  student     User             @relation(fields: [studentId], references: [id])
  status      SubmissionStatus @default(IN_PROGRESS)
  attemptNumber Int              @default(1)
  startedAt   DateTime         @default(now())
  submittedAt DateTime?
  gradedAt    DateTime?
  totalScore  Int?
  answers     Answer[]
  integrityEvents IntegrityEvent[]
  gradePassback   CanvasGradePassback?
  networkEvidence NetworkEvidence[]
  // On-Device AI Camera Integrity Detection v1 — Evidence Frames
  // (additive, opt-in). See docs/on-device-ai-integrity-detection-v1.md.
  evidenceAssets  IntegrityEvidenceAsset[]

  // One-Question-At-A-Time Exam Delivery v1 (additive, opt-in) — see
  // docs/one-question-delivery-v1.md. questionOrderJson stores the
  // stable per-submission question order (and, if randomiseMcqOptionOrder
  // is on, per-question MCQ option order) generated once at attempt
  // start — never recomputed, so it survives refresh. Null when
  // randomiseQuestionOrder was off at attempt start (falls back to the
  // exam's original Question.order at read time). currentQuestionIndex
  // is the student's furthest/current position when
  // oneQuestionAtATime is enabled; unused (stays 0) otherwise.
  questionOrderJson    Json?
  currentQuestionIndex Int   @default(0)

  // Answer Similarity Review + Oral Verification v1 (additive) — see
  // docs/answer-similarity-review-v1.md and
  // docs/oral-verification-workflow-v1.md.
  similarityMatchesAsSource   SubmissionSimilarityMatch[] @relation("SimilarityMatchSource")
  similarityMatchesAsCompared SubmissionSimilarityMatch[] @relation("SimilarityMatchCompared")
  oralVerifications           OralVerification[]

  // AI-Use Answer Review v1 (additive) — see docs/ai-use-answer-review-v1.md.
  aiUseReviewAnalysis AiUseReviewAnalysis?

  // Exam Session Binding + Time Anomaly Review v1 (additive) — see
  // docs/exam-session-binding-v1.md and docs/time-anomaly-review-v1.md.
  examAttemptSessions      ExamAttemptSession[]
  sessionIntegritySignals  SessionIntegritySignal[]
  answerActivityEvents     AnswerActivityEvent[]
  timingAnalysis           TimingAnalysis?

  // Exam Design Policy + Evidence Review v1 (additive) — see
  // docs/exam-design-policy-v1.md. The immutable policy snapshot taken
  // at attempt start (see src/lib/examPolicy.ts:buildExamPolicySnapshot).
  // Null for every submission created before this feature shipped, and
  // for any exam where no policy was ever configured — a null snapshot
  // is never treated as evidence of anything, and this attempt's
  // integrity signals are always interpreted with UNKNOWN policy
  // alignment rather than retrospectively judged against a policy that
  // did not exist when the attempt happened. Never rewritten after
  // creation, even if the exam's own secureSettings/policy change later.
  examPolicySnapshotJson Json?
  integrityReviewComments       IntegrityReviewComment[]
  integrityReviewStatusHistory  IntegrityReviewStatusHistory[]

  // Question Navigator v1 (additive, opt-in) — see
  // docs/question-navigator-v1.md.
  questionStates SubmissionQuestionState[]

  // Controlled AI Brainstorming Assistance v1 (additive, opt-in) — see
  // docs/controlled-ai-brainstorming-assistance-v1.md. The effective AI-
  // assistance policy (mode + limits + allowed-capability flags) copied
  // at attempt start — exactly the same immutable-snapshot pattern as
  // examPolicySnapshotJson above. All later assistance decisions for this
  // attempt (limits, allowed capabilities) MUST read this snapshot, never
  // the exam's current (possibly since-changed) secureSettings. Null for
  // every submission created before this feature shipped, or where AI
  // assistance was never configured — always treated as DISABLED, never
  // silently active.
  aiAssistancePolicySnapshotJson Json?
  aiAssistanceInteractions       AiAssistanceInteraction[]

  // Screen-share Evidence Mode v1 (additive, opt-in) — see
  // docs/screen-share-evidence-v1.md. Same immutable-snapshot pattern as
  // examPolicySnapshotJson/aiAssistancePolicySnapshotJson above: the
  // effective screen-share policy (mode, evidence capture, interval,
  // max frames) copied once at attempt start. Null for every submission
  // created before this feature, or any exam where it was never
  // configured — always treated as OFF, never silently required.
  screenSharePolicySnapshotJson Json?

  // Cohort-Level Collusion Detection and Integrity Graph v1 (additive) —
  // see docs/cohort-collusion-graph-v1.md. A submission is a graph node;
  // an edge represents a possible relationship with another submission,
  // never a finding on its own.
  collusionEdgesAsSource       CollusionPairEdge[]       @relation("CollusionEdgeSource")
  collusionEdgesAsCompared     CollusionPairEdge[]       @relation("CollusionEdgeCompared")
  collusionClusterMemberships  CollusionClusterMember[]

  // Answer-Development Provenance v1 (additive, opt-in) — see
  // docs/answer-development-provenance-v1.md. Same immutable-snapshot
  // pattern as examPolicySnapshotJson/aiAssistancePolicySnapshotJson/
  // screenSharePolicySnapshotJson above: the effective provenance policy
  // (mode, version-capture limits, enabled workspaces, source-declaration
  // requirement) copied once at attempt start. Null for every submission
  // created before this feature, or any exam where it was never
  // configured — always treated as OFF, never silently capturing
  // anything. This is PROCESS EVIDENCE, not a misconduct detector — see
  // that doc for the full privacy/threat-model treatment.
  answerProvenancePolicySnapshotJson Json?
  answerDevelopmentVersions          AnswerDevelopmentVersion[]
  answerDevelopmentEvents            AnswerDevelopmentEvent[]
  answerDevelopmentArtifacts         AnswerDevelopmentArtifact[]
  codeExecutionEvents                CodeExecutionEvent[]

  // Tether Secure Client Foundation + Safe Exam Browser Compatibility v1
  // (additive, opt-in) — see docs/secure-client-foundation-seb-v1.md. Same
  // immutable-snapshot pattern as examPolicySnapshotJson/
  // aiAssistancePolicySnapshotJson/screenSharePolicySnapshotJson/
  // answerProvenancePolicySnapshotJson above. Null means legacy behaviour
  // / STANDARD_WEB — never silently required. An existing IN_PROGRESS
  // attempt at deploy time can never retroactively become secure-client-
  // required, exactly like every other snapshot in this codebase.
  secureClientPolicySnapshotJson Json?
  secureClientLaunchManifests     SecureClientLaunchManifest[]
  secureClientSessions            SecureClientSession[]
  secureClientEvents              SecureClientEvent[]
  secureClientRecoveryGrants      SecureClientRecoveryGrant[]

  @@unique([examId, studentId, attemptNumber])
  @@index([examId, studentId])
}

// Question Navigator v1 (additive, opt-in) — see
// docs/question-navigator-v1.md. Tracks ONLY visited/flagged state per
// question per submission — never a copy of the answer text (that stays
// solely in Answer.response; "answered" is always derived from there).
// One row per question the student has visited and/or flagged; a
// question with no row is simply "not visited, not flagged" — no row is
// ever required to exist.
model SubmissionQuestionState {
  id             String     @id @default(cuid())
  submissionId   String
  submission     Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId     String
  question       Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  firstVisitedAt DateTime?
  lastVisitedAt  DateTime?
  flaggedForReview Boolean  @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([submissionId, questionId])
  @@index([submissionId])
  @@index([questionId])
  @@index([submissionId, flaggedForReview])
}

model Answer {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId   String
  question     Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  response          String?
  score             Int?
  feedback          String?
  isCorrect         Boolean?
  timeSpentSeconds  Int?
  aiDraftScore      Float?
  aiReasoning       String?
  aiGradedAt        DateTime?
  // AI-Use Answer Review v1 (additive) — see docs/ai-use-answer-review-v1.md.
  aiUseReviewSignals AiUseReviewSignal[]

  // Answer-Development Provenance v1 (additive, opt-in) — see
  // docs/answer-development-provenance-v1.md.
  developmentVersions AnswerDevelopmentVersion[]
  developmentEvents   AnswerDevelopmentEvent[]
  developmentArtifacts AnswerDevelopmentArtifact[]
  codeExecutionEvents  CodeExecutionEvent[]

  @@unique([submissionId, questionId])
}

model IntegrityEvent {
  id             String             @id @default(cuid())
  submissionId   String
  submission     Submission         @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  examId         String
  exam           Exam               @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId      String
  student        User               @relation("IntegrityEventStudent", fields: [studentId], references: [id])
  eventType      IntegrityEventType
  severity       IntegritySeverity
  message        String
  metadataJson   Json?
  occurredAt     DateTime
  createdAt      DateTime           @default(now())
  resolvedAt     DateTime?
  resolvedById   String?
  resolvedBy     User?              @relation("IntegrityEventResolver", fields: [resolvedById], references: [id])
  resolutionNote String?
  // On-Device AI Camera Integrity Detection v1 — Evidence Frames
  // (additive, opt-in). See docs/on-device-ai-integrity-detection-v1.md.
  // At most one per event in v1 (enforced by @unique on the asset's
  // integrityEventId below).
  evidenceAsset  IntegrityEvidenceAsset?

  // Exam Design Policy + Evidence Review v1 (additive) — see
  // docs/evidence-review-workflow-v1.md. The old resolvedAt/resolvedById/
  // resolutionNote above predate this feature and represent a single
  // resolved/unresolved boolean — kept exactly as-is, still written by
  // the legacy POST .../resolve route for backward compatibility (which
  // also now sets reviewStatus below to keep both views consistent).
  // reviewStatus is the new 5-state workflow field; validated string, not
  // a Prisma enum, following the SubmissionSimilarityAnalysis convention
  // — see src/lib/integrityReview.ts. reviewedAt/reviewedById/reviewNote
  // are new, separate from the legacy trio above, because "reviewed — no
  // concern" is not the same fact as "resolved".
  reviewStatus  String    @default("NEEDS_REVIEW") // NEEDS_REVIEW | REVIEWED_NO_CONCERN | REVIEWED_CONCERN_REMAINS | ESCALATED | RESOLVED
  reviewedAt    DateTime?
  reviewedById  String?
  reviewedBy    User?     @relation("IntegrityEventReviewer", fields: [reviewedById], references: [id])
  reviewNote    String?

  comments      IntegrityReviewComment[]
  statusHistory IntegrityReviewStatusHistory[]

  @@index([submissionId])
  @@index([examId])
  @@index([studentId])
  @@index([eventType])
  @@index([severity])
  @@index([occurredAt])
  @@index([reviewStatus])
}

// Exam Design Policy + Evidence Review v1 (additive) — see
// docs/evidence-review-workflow-v1.md. A freeform reviewer comment on
// one integrity event (optionally scoped to a specific evidence frame).
// Comments are immutable in practice — the API never exposes an edit or
// delete action, only create — updatedAt exists purely for Prisma's
// @updatedAt convention and is expected to always equal createdAt.
// authorRole/commentType are always derived server-side from the
// authenticated session, never accepted from the client (see
// docs/evidence-review-workflow-v1.md, "Reviewer identity"). This repo
// has no separate marker role/assignment — see
// docs/course-enrolment-and-exam-assignment.md and prisma/schema.prisma's
// Role enum — so commentType is REVIEWER_COMMENT for a PLATFORM_ADMIN or
// LECTURER_COMMENT for an actual LECTURER; MARKER_COMMENT is defined for
// forward-compatibility only and is never produced by any route today.
model IntegrityReviewComment {
  id               String                  @id @default(cuid())
  integrityEventId String
  integrityEvent   IntegrityEvent          @relation(fields: [integrityEventId], references: [id], onDelete: Cascade)
  evidenceAssetId  String?
  evidenceAsset    IntegrityEvidenceAsset? @relation(fields: [evidenceAssetId], references: [id], onDelete: SetNull)
  submissionId     String
  submission       Submission              @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  authorId         String
  author           User                    @relation("IntegrityReviewCommentAuthor", fields: [authorId], references: [id])
  authorRole       String // "LECTURER" | "PLATFORM_ADMIN" — server-derived, never client-supplied
  commentType      String // REVIEWER_COMMENT | LECTURER_COMMENT | MARKER_COMMENT | DECISION_NOTE
  comment          String
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([integrityEventId])
  @@index([submissionId])
  @@index([evidenceAssetId])
}

// Exam Design Policy + Evidence Review v1 (additive) — see
// docs/evidence-review-workflow-v1.md. One immutable row per status
// transition — created on EVERY reviewStatus change (including the
// initial implicit NEEDS_REVIEW is never written here; only actual
// transitions are). Never updated or deleted by any route — this is the
// audit-grade history a lecturer sees in the UI, distinct from
// PlatformAuditLog (which is the platform-wide operational audit trail).
model IntegrityReviewStatusHistory {
  id               String         @id @default(cuid())
  integrityEventId String
  integrityEvent   IntegrityEvent @relation(fields: [integrityEventId], references: [id], onDelete: Cascade)
  submissionId     String
  submission       Submission     @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  fromStatus       String?
  toStatus         String
  changedById      String
  changedBy        User           @relation("IntegrityReviewStatusChanger", fields: [changedById], references: [id])
  changedByRole    String
  reason           String?
  createdAt        DateTime       @default(now())

  @@index([integrityEventId])
  @@index([submissionId])
}

// Course, Enrolment, Exam Assignment, Scheduling v1 — see
// docs/course-enrolment-and-exam-assignment.md. Course is the academic
// grouping inside an Institution (the hard tenancy boundary). It does not
// replace Institution-level isolation — every Course belongs to exactly
// one Institution, and cross-institution access is still governed by
// institutionScope.ts exactly as before.
model Course {
  id            String             @id @default(cuid())
  institutionId String
  institution   Institution        @relation(fields: [institutionId], references: [id])
  name          String
  code          String
  description   String?
  active        Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  enrollments   CourseEnrollment[]
  exams         Exam[]
  // Canvas/LTI mapping hook (v1 foundation only) — see
  // docs/course-enrolment-and-exam-assignment.md Part 7. Exam-level
  // Canvas mapping already exists via LtiExamLink; these are the
  // course-level equivalent, added additively and unused by existing
  // LTI code paths so nothing breaks if left unset.
  canvasCourseId String?
  ltiPlatformId  String?

  @@unique([institutionId, code])
  @@index([institutionId])
}

model CourseEnrollment {
  id        String     @id @default(cuid())
  courseId  String
  course    Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      CourseRole
  createdAt DateTime   @default(now())

  @@unique([courseId, userId])
  @@index([courseId])
  @@index([userId])
}

// Selected-student exam assignment — only meaningful when the owning
// Exam has assignmentMode: SELECTED_STUDENTS. Ignored otherwise.
model ExamAssignment {
  id        String   @id @default(cuid())
  examId    String
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([examId, studentId])
  @@index([examId])
  @@index([studentId])
}

model LtiPlatform {
  id            String       @id @default(cuid())
  issuer        String       @unique
  clientId      String
  authEndpoint  String
  tokenEndpoint String
  jwksUrl       String
  deploymentId  String
  createdAt     DateTime     @default(now())
  sessions      LtiSession[]
  examLinks     LtiExamLink[]
  launches      LtiLaunch[]
  // Multi-Tenant Architecture v1 (additive, nullable) — one platform
  // (Canvas instance) belongs to exactly one institution.
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])
}

model LtiSession {
  id         String      @id @default(cuid())
  platform   LtiPlatform @relation(fields: [platformId], references: [id])
  platformId String
  nonce      String      @unique
  state      String      @unique
  expiresAt  DateTime
  consumed   Boolean     @default(false)
  createdAt  DateTime    @default(now())
}

model LtiExamLink {
  id                 String   @id @default(cuid())
  examId             String
  exam               Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  platformId         String
  platform           LtiPlatform @relation(fields: [platformId], references: [id])
  resourceLinkId     String
  canvasCourseId     String?
  canvasAssignmentId String?
  label              String?
  createdAt          DateTime @default(now())

  @@unique([platformId, resourceLinkId])
  @@index([examId])
}

model LtiLaunch {
  id                 String   @id @default(cuid())
  platformId         String
  // Relation field added so launches can be scoped to their platform's
  // institution (see docs/multi-tenant-migration.md). This does not add a
  // database column — platformId already existed; this only adds the
  // Prisma-level join, matching the existing pattern on LtiSession/LtiExamLink.
  platform           LtiPlatform @relation(fields: [platformId], references: [id])
  canvasUserId       String
  canvasCourseId     String
  canvasAssignmentId String?
  lineitems          String?
  sourcedid          String?
  examId             String?
  submissionId       String?
  // --- AGS hardening (additive) ---
  deploymentId       String?
  resourceLinkId     String?
  lineitemUrl        String?
  lineitemsUrl       String?
  agsScopeJson       Json?
  // Raw verified launch claims, kept server-side only for debugging.
  // Never returned to students or in any client-facing API response.
  launchClaimsJson   Json?
  launchRole         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  gradePassbacks     CanvasGradePassback[]
}

model CanvasGradePassback {
  id                 String               @id @default(cuid())
  submissionId       String               @unique
  submission         Submission           @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  ltiLaunchId        String?
  ltiLaunch          LtiLaunch?           @relation(fields: [ltiLaunchId], references: [id])
  status             CanvasPassbackStatus @default(NOT_READY)
  scoreGiven         Float?
  scoreMaximum       Float?
  scorePct           Float?
  attemptedAt        DateTime?
  sentAt             DateTime?
  errorMessage       String?
  canvasResponseJson Json?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([status])
}

// Academic Integrity Network Evidence v1 — see
// docs/network-evidence-and-ip-location.md. Records IP address,
// approximate IP-based location, and browser/device metadata at exam
// open and exam submit. Evidence-only: never blocks a student, never
// auto-determines misconduct.
model NetworkEvidence {
  id               String   @id @default(cuid())
  submissionId     String
  submission       Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  examId           String
  exam             Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId        String
  student          User     @relation("NetworkEvidenceStudent", fields: [studentId], references: [id])
  institutionId    String
  // source: EXAM_START captured at new submission creation;
  // EXAM_SUBMIT captured on final submit.
  source           String
  ipAddress        String?
  ipHash           String?
  userAgent        String?
  browserName      String?
  osName           String?
  deviceType       String?
  country          String?
  region           String?
  city             String?
  timezone         String?
  locationAccuracy String   @default("UNAVAILABLE")
  vpnOrProxySignal Boolean  @default(false)
  networkChanged   Boolean  @default(false)
  metadata         Json?
  createdAt        DateTime @default(now())

  @@index([submissionId])
  @@index([examId])
  @@index([studentId])
  @@index([institutionId])
  @@index([createdAt])
}

// On-Device AI Camera Integrity Detection v1 — Evidence Frames (additive,
// opt-in) — see docs/on-device-ai-integrity-detection-v1.md. A single,
// privacy-minimised webcam still frame, captured only when the exam's
// secureSettings.captureAiViolationEvidence is enabled AND a
// POSSIBLE_PHONE_VISIBLE or POSSIBLE_SECOND_PERSON_VISIBLE event is
// backend-logged — never on every overlay redisplay, never a video,
// never the exam screen/desktop, never used for face recognition or any
// biometric identification. Image bytes are never stored inline here or
// in IntegrityEvent.metadataJson — only a storageKey pointing into
// src/lib/evidenceStorage.ts, resolved server-side only through the
// authenticated, audited GET /api/integrity-evidence/[evidenceAssetId]
// route. institutionId is a plain scoping column, not a navigated
// relation — mirrors NetworkEvidence.institutionId above.
model IntegrityEvidenceAsset {
  id               String                 @id @default(cuid())
  integrityEventId String                 @unique
  integrityEvent   IntegrityEvent         @relation(fields: [integrityEventId], references: [id], onDelete: Cascade)
  submissionId     String
  submission       Submission             @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  examId           String
  exam             Exam                   @relation(fields: [examId], references: [id], onDelete: Cascade)
  institutionId    String

  kind      String // "AI_CAMERA_EVIDENCE_FRAME" in v1 — see src/lib/aiCameraEvidenceFrame.ts
  eventType String // "POSSIBLE_PHONE_VISIBLE" | "POSSIBLE_SECOND_PERSON_VISIBLE" in v1

  storageProvider String // "local_dev" | "vercel_blob" | "supabase_storage" | "s3" — see src/lib/evidenceStorage.ts
  storageKey      String // Opaque; never returned to any client — resolved server-side only.
  contentType     String
  byteSize        Int
  sha256          String?

  width         Int?
  height        Int?
  redactionMode String   @default("LOW_RES_FULL_FRAME")
  capturedAt    DateTime @default(now())

  // Screen-share Evidence Mode v1 (additive) — see
  // docs/screen-share-evidence-v1.md. Idempotency key: a client-generated
  // id (one per logical capture action), unique when present. Nullable —
  // camera evidence frames (v1) never set it; Postgres allows unlimited
  // NULLs in a unique index, so only actual duplicate non-null keys
  // collide. Lets a retried/duplicated upload request be recognised and
  // replayed instead of silently creating a second evidence asset and
  // consuming a second slot against the attempt's max-frames limit.
  clientRequestId String? @unique

  createdAt DateTime @default(now())

  // Exam Design Policy + Evidence Review v1 (additive) — see
  // docs/evidence-review-workflow-v1.md. A comment may optionally be
  // scoped to this specific evidence frame rather than the event as a
  // whole.
  reviewComments IntegrityReviewComment[]

  @@index([integrityEventId])
  @@index([submissionId])
  @@index([examId])
  @@index([institutionId])
  @@index([capturedAt])
}

// AI-Use Answer Review v1 (additive) — see docs/ai-use-answer-review-v1.md.
// This is NOT an AI detector: every row here is an explainable REVIEW
// SIGNAL about observable answer characteristics for a human lecturer to
// weigh — never a claim that an answer was written by AI, never an
// automatic misconduct finding, never a grade input. Status/level/type/
// review-status fields are plain validated String columns (not Prisma
// enums), following the SubmissionSimilarityAnalysis convention — see
// src/lib/aiUseReview.ts for the validators. One reusable row per
// submission (a re-run replaces its prior signals, mirroring
// runSimilarityAnalysisForExam's reuse pattern).
model AiUseReviewAnalysis {
  id           String     @id @default(cuid())
  submissionId String     @unique
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  examId       String
  exam         Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  status       String     @default("PENDING") // PENDING | PROCESSING | COMPLETE | FAILED | NOT_CONFIGURED
  overallSignalLevel String @default("NONE") // NONE | LOW | MEDIUM | HIGH
  // "deterministic" (Layer A only) or "anthropic" (Layer A + optional
  // Layer B) — never a claim about who/what "detected" anything.
  provider        String
  modelIdentifier String?
  algorithmVersion String
  analysedAt      DateTime?
  requestedById   String
  requestedBy     User      @relation("AiUseReviewRequestedBy", fields: [requestedById], references: [id])
  failureCode     String?
  recommendation  String    @default("NO_IMMEDIATE_ACTION") // NO_IMMEDIATE_ACTION | LECTURER_REVIEW_RECOMMENDED | ORAL_VERIFICATION_RECOMMENDED
  reasonCodesJson Json?
  summaryJson     Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  signals         AiUseReviewSignal[]

  @@index([examId])
  @@index([status])
}

// One explainable signal produced by one analysis run — see
// docs/ai-use-answer-review-v1.md. evidenceJson holds only short,
// explainable observations (never the full answer text, never a hidden
// AI-generated "chain of thought"). questionId is the question the
// signal concerns; answerId is nullable because a signal may be derived
// from comparing multiple answers (e.g. writing-style consistency) with
// no single "the" answer it belongs to.
model AiUseReviewSignal {
  id           String              @id @default(cuid())
  analysisId   String
  analysis     AiUseReviewAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  questionId   String
  question     Question            @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answerId     String?
  answer       Answer?             @relation(fields: [answerId], references: [id], onDelete: SetNull)
  signalType   String // WEAK_SCENARIO_GROUNDING | GENERIC_RESPONSE | STYLE_INCONSISTENCY | UNSUPPORTED_SPECIFIC_CLAIMS | REQUIRED_CONCEPTS_MISSING | POLISHED_BUT_SHALLOW_RESPONSE | GENERATED_RESPONSE_META_LANGUAGE
  signalLevel  String // NONE | LOW | MEDIUM | HIGH
  explanation  String
  evidenceJson Json?
  reviewStatus String    @default("NEEDS_REVIEW") // NEEDS_REVIEW | REVIEWED_NO_CONCERN | REVIEWED_CONCERN_REMAINS | ESCALATED | RESOLVED
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?     @relation("AiUseReviewSignalReviewer", fields: [reviewedById], references: [id])
  reviewNote   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([analysisId])
  @@index([questionId])
  @@index([answerId])
  @@index([reviewStatus])
}

// Exam Session Binding + Time Anomaly Review v1 (additive) — see
// docs/exam-session-binding-v1.md and docs/time-anomaly-review-v1.md.
// THIS PRODUCES LECTURER REVIEW SIGNALS ONLY — never an automatic
// misconduct finding, never a grade input, never an automatic attempt
// termination. Only HMAC hashes, coarse categories, and IP network
// PREFIXES are ever stored — never raw IP addresses, raw tokens, or raw
// user-agent strings needed for display (userAgentHash exists purely for
// server-side comparison). Status/type/level/review-status fields are
// plain validated String columns (not Prisma enums), following the
// SubmissionSimilarityAnalysis convention — see src/lib/sessionBinding.ts
// and src/lib/sessionIntegrity.ts for the validators.
model ExamAttemptSession {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation("ExamAttemptSessionUser", fields: [userId], references: [id], onDelete: Cascade)

  // Server-issued, HMAC-hashed only — the raw token lives solely in a
  // Secure/HttpOnly/SameSite cookie on the student's browser, never in
  // the database and never returned by any API response.
  browserSessionTokenHash String
  deviceTokenHash         String

  // Supporting signal only — never the primary binding mechanism. See
  // Part 2 (allowed low-entropy inputs only: browser/OS family, device
  // category, accepted language, timezone, screen-size bucket).
  coarseFingerprintHash String?
  userAgentHash         String?
  browserFamily         String?
  operatingSystemFamily String?
  deviceCategory        String?

  // Network prefix only (never a raw IP) — /24 for IPv4, /48 for IPv6,
  // HMAC-hashed. See src/lib/sessionBinding.ts.
  ipPrefixHash String?
  ipVersion    String? // "v4" | "v6"

  // granted | denied | prompt | unavailable | unknown — Permissions API
  // absence is "unknown", never treated as a violation.
  cameraPermissionState String @default("unknown")

  startedAt DateTime  @default(now())
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  endedAt     DateTime?
  status      String    @default("ACTIVE") // ACTIVE | STALE | ENDED | REPLACED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  signals SessionIntegritySignal[]
  activityEvents AnswerActivityEvent[]
  // Answer-Development Provenance v1 (additive, opt-in) — see
  // docs/answer-development-provenance-v1.md.
  developmentEvents AnswerDevelopmentEvent[]

  @@index([submissionId])
  @@index([userId])
  @@index([status])
  @@index([lastSeenAt])
  @@index([deviceTokenHash])
}

// One explainable session-binding review signal — see
// docs/exam-session-binding-v1.md. examAttemptSessionId is nullable
// because a signal (e.g. CONCURRENT_ACTIVE_SESSIONS) may concern more
// than one session with no single "the" session it belongs to.
model SessionIntegritySignal {
  id                   String              @id @default(cuid())
  submissionId         String
  submission           Submission          @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  examAttemptSessionId String?
  examAttemptSession   ExamAttemptSession? @relation(fields: [examAttemptSessionId], references: [id], onDelete: SetNull)

  signalType   String // CONCURRENT_ACTIVE_SESSIONS | DEVICE_TOKEN_CHANGED | COARSE_DEVICE_PROFILE_CHANGED | USER_AGENT_CHANGED | NETWORK_PREFIX_CHANGED | REPEATED_NETWORK_CHANGES | CAMERA_PERMISSION_CHANGED | SESSION_TOKEN_MISMATCH | SESSION_RESTARTED
  signalLevel  String // LOW | MEDIUM | HIGH
  explanation  String
  evidenceJson Json?

  reviewStatus String    @default("NEEDS_REVIEW") // NEEDS_REVIEW | REVIEWED_NO_CONCERN | REVIEWED_CONCERN_REMAINS | ESCALATED | RESOLVED
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?     @relation("SessionIntegritySignalReviewer", fields: [reviewedById], references: [id])
  reviewNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([submissionId])
  @@index([examAttemptSessionId])
  @@index([reviewStatus])
}

// Coarse activity telemetry — see docs/exam-session-binding-v1.md. Never
// stores keystrokes, clipboard content, or a duplicate of the full
// answer text: only a length, an HMAC hash of the normalised response
// (for change-detection, not reconstruction), and a length delta.
// previousEventId is an advisory pointer only (no FK) to the prior
// ANSWER_SAVED event for the same question, used to compute the delta —
// deliberately not a Prisma relation, since it is never used for
// cascade behaviour. serverReceivedAt is authoritative; clientElapsedMs
// is supplementary only and never overrides it.
model AnswerActivityEvent {
  id                   String              @id @default(cuid())
  submissionId         String
  submission           Submission          @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId           String?
  question             Question?           @relation(fields: [questionId], references: [id], onDelete: SetNull)
  examAttemptSessionId String?
  examAttemptSession   ExamAttemptSession? @relation(fields: [examAttemptSessionId], references: [id], onDelete: SetNull)

  eventType String // ATTEMPT_STARTED | QUESTION_OPENED | ANSWER_SAVED | QUESTION_NAVIGATED | HEARTBEAT | PAGE_HIDDEN | PAGE_VISIBLE | ATTEMPT_SUBMITTED

  serverReceivedAt  DateTime @default(now())
  clientElapsedMs   Int?
  questionIndex     Int?
  responseLength    Int?
  responseHash      String?
  responseLengthDelta Int?
  previousEventId   String?
  metadataJson      Json?

  createdAt DateTime @default(now())

  @@index([submissionId])
  @@index([questionId])
  @@index([examAttemptSessionId])
  @@index([eventType])
  @@index([serverReceivedAt])
}

// One reusable timing-analysis row per submission — mirrors
// AiUseReviewAnalysis's shape/reuse pattern. Added beyond the models
// Part 3 enumerated because Part 13's separate
// PATCH /api/lecturer/timing-signals/[signalId]/review route (distinct
// from session-signals) requires its own signal storage — see
// docs/time-anomaly-review-v1.md.
model TimingAnalysis {
  id           String     @id @default(cuid())
  submissionId String     @unique
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  examId       String
  exam         Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)

  status             String    @default("PENDING") // PENDING | PROCESSING | COMPLETE | FAILED
  overallSignalLevel String    @default("NONE") // NONE | LOW | MEDIUM | HIGH
  algorithmVersion   String
  analysedAt         DateTime?
  requestedById      String
  requestedBy        User      @relation("TimingAnalysisRequestedBy", fields: [requestedById], references: [id])

  recommendation  String @default("NO_IMMEDIATE_ACTION") // NO_IMMEDIATE_ACTION | LECTURER_REVIEW_RECOMMENDED | ORAL_VERIFICATION_RECOMMENDED | ESCALATION_RECOMMENDED
  reasonCodesJson Json?
  summaryJson     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  signals TimingIntegritySignal[]

  @@index([examId])
  @@index([status])
}

model TimingIntegritySignal {
  id         String         @id @default(cuid())
  analysisId String
  analysis   TimingAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  signalType   String // EXTREMELY_FAST_ATTEMPT | RAPID_MULTI_QUESTION_COMPLETION | RAPID_LARGE_RESPONSE_APPEARANCE | LONG_INACTIVITY_THEN_LARGE_RESPONSE | VERY_FAST_CORRECT_RESPONSE_PATTERN | SIMILAR_RESPONSE_TIMING_PATTERN | ABRUPT_ACTIVITY_BURST | INSUFFICIENT_TIMING_DATA
  signalLevel  String // LOW | MEDIUM | HIGH
  explanation  String
  evidenceJson Json?

  reviewStatus String    @default("NEEDS_REVIEW")
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?     @relation("TimingIntegritySignalReviewer", fields: [reviewedById], references: [id])
  reviewNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([analysisId])
  @@index([reviewStatus])
}

model QuestionBank {
  id          String         @id @default(cuid())
  lecturerId  String
  title       String
  description String?
  subject     String?
  courseCode  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  lecturer    User           @relation(fields: [lecturerId], references: [id])
  questions   BankQuestion[]

  @@index([lecturerId])
}

model BankQuestion {
  id            String       @id @default(cuid())
  bankId        String
  type          String
  text          String
  optionsJson   String?
  correctAnswer String?
  sampleAnswer  String?
  points        Int          @default(1)
  difficulty    String?
  topic         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  bank          QuestionBank @relation(fields: [bankId], references: [id], onDelete: Cascade)

  @@index([bankId])
  @@index([type])
  @@index([topic])
  @@index([difficulty])
}

// Controlled AI Brainstorming Assistance v1 (additive, opt-in) — see
// docs/controlled-ai-brainstorming-assistance-v1.md. One row per student
// request. This is an AUDITABLE RECORD OF AN ALLOWED ASSESSMENT RESOURCE,
// not an integrity-violation log — status/riskCodes describe the
// generator/verifier pipeline's own internal decision-making, never a
// finding about the student. `status`/`riskCodes` are validated strings,
// not Prisma enums, following the SubmissionSimilarityAnalysis/
// IntegrityEvidenceAsset convention (see src/lib/aiAssistancePolicy.ts for
// validation). `approvedResponse` is null whenever the request was
// blocked pre-generation (status "BLOCKED") — the verifier's rejected
// candidate text is NEVER stored anywhere, on any status, since it may
// contain prohibited answer content (see src/lib/aiAssistanceRunner.ts).
model AiAssistanceInteraction {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId   String
  question     Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  examId       String
  studentId    String
  student      User       @relation(fields: [studentId], references: [id])

  studentPrompt    String
  // Null for every status except APPROVED/FALLBACK (BLOCKED and FAILED
  // never have a response — see status below).
  approvedResponse String?

  // Hardening v1.1 (see docs/controlled-ai-brainstorming-assistance-v1.md,
  // "Interaction status lifecycle") — six explicit states rather than
  // ambiguous free-text values:
  //   RESERVED  — a prompt slot was atomically reserved for this request;
  //               this row exists but no terminal outcome has been
  //               recorded yet. Should be extremely short-lived (the
  //               whole request completes synchronously in one server
  //               invocation) — a row still RESERVED after
  //               STALE_RESERVATION_MS (src/lib/aiAssistancePolicy.ts)
  //               indicates the server crashed/timed out mid-request and
  //               is treated as an effectively-failed request by the
  //               lecturer review and prompt-accounting reads, never as
  //               a silently-forever-pending state.
  //   APPROVED  — a candidate passed verification and was shown to the
  //               student (see wasRegenerated below for whether this took
  //               a first-try pass or the stricter regeneration).
  //   BLOCKED   — the classifier rejected the request before any
  //               generation ran.
  //   FALLBACK  — generation/verification completed (no provider error)
  //               but no candidate ever passed verification; the fixed
  //               deterministic Socratic fallback text was shown instead.
  //   FAILED    — a genuine provider/parsing failure (timeout, malformed
  //               output, etc.) on every attempt — no model output and no
  //               fallback text was shown; a generic "temporarily
  //               unavailable" message was returned instead.
  // A prior version of this column additionally had a distinct
  // "REGENERATED_APPROVED" value — folded into APPROVED + wasRegenerated
  // below instead, since this schema change was made before this feature
  // was ever applied to any real database (see docs/migration-ledger.md,
  // row 10 — still PENDING at the time of this change), so no backfill
  // was required.
  status String

  // True when the FIRST candidate failed verification and the response
  // actually shown came from the single stricter regeneration attempt
  // (Part 9 of the original spec) — tracked as a flag on the same row
  // rather than a separate status value, since the task's "explicit
  // statuses" requirement and "regeneration remains part of the same
  // interaction" requirement are both about ONE thing each (terminal
  // outcome vs. how it was reached), not the same axis.
  wasRegenerated Boolean @default(false)

  // Idempotency key (Part 2 — concurrency hardening). Supplied by the
  // client (crypto.randomUUID(), generated once per logical "send"
  // action — see src/components/AiBrainstormPanel.tsx) so a duplicate
  // POST from a double-click or a browser-level retry of the same
  // request is recognised and replayed rather than silently consuming a
  // second prompt slot. Nullable (a request without one is simply never
  // deduplicated) with a unique index — Postgres allows unlimited NULLs
  // in a unique index, so only actual duplicate non-null keys collide.
  clientRequestId String? @unique

  promptNumberForQuestion Int
  promptNumberForAttempt  Int
  policyVersion           String

  // Structured verifier output (Part 8) — riskCodesJson is a JSON array of
  // strings (DIRECT_ANSWER, NEAR_COMPLETE_ANSWER, etc; empty array for a
  // BLOCKED or cleanly-APPROVED interaction with nothing flagged).
  riskCodesJson        Json?
  riskScore            Float @default(0)
  cumulativeRiskScore  Float @default(0)
  specificityLevel     Int   @default(0)

  providerModel String?
  latencyMs     Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([submissionId])
  @@index([submissionId, questionId])
  @@index([examId])
  @@index([studentId])
  @@index([submissionId, createdAt])
}

// Cohort-Level Collusion Detection and Integrity Graph v1 (additive) — see
// docs/cohort-collusion-graph-v1.md. THIS PRODUCES REVIEW SIGNALS ONLY —
// "possible coordinated-answer cluster", never "confirmed collusion" or
// "students cheated". It consumes the outputs of the pre-existing
// SubmissionSimilarityAnalysis, TimingAnalysis, ExamAttemptSession/
// SessionIntegritySignal, and NetworkEvidence features above — it does
// not replace or duplicate any of them, and never alters a grade,
// submission, or existing integrity evidence. Status/level/type fields
// are plain validated String columns (not Prisma enums), following the
// SubmissionSimilarityAnalysis convention — see
// src/lib/cohortCollusionThresholds.ts and src/lib/cohortCollusion/graph.ts
// for the validators. One reusable row per exam — a re-run replaces the
// previous machine-generated edges/signals/clusters (deleteMany + create
// inside one transaction, mirroring runSimilarityAnalysisForExam) but
// never deletes a cluster's lecturer review history fields
// (reviewStatus/reviewedAt/reviewedById/reviewNote), which the runner
// carries forward onto the recreated cluster row with the same
// clusterKey — see docs/cohort-collusion-graph-v1.md, "Repeated analysis
// runs".
model CohortCollusionAnalysis {
  id     String @id @default(cuid())
  examId String
  exam   Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)

  status           String    @default("PENDING") // PENDING | PROCESSING | COMPLETE | FAILED | INSUFFICIENT_DATA
  algorithmVersion String
  analysedAt       DateTime?

  submissionCount   Int @default(0)
  eligibleEdgeCount Int @default(0)
  clusterCount      Int @default(0)
  // NONE | WATCH | NEEDS_REVIEW | HIGHER_CONCERN — highest concernLevel of
  // any cluster produced by this run; NONE when no cluster was formed.
  overallReviewLevel String @default("NONE")

  summaryJson Json?

  requestedById String
  requestedBy   User   @relation("CohortCollusionAnalysisRequestedBy", fields: [requestedById], references: [id])

  failureCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  edges    CollusionPairEdge[]
  clusters CollusionCluster[]

  @@index([examId])
  @@index([status])
}

// One possible pairwise relationship between two submissions of the same
// exam — an edge on the integrity graph, never a finding on its own. Pair
// ordering is canonical (sourceSubmissionId < comparedSubmissionId
// lexicographically, mirroring SubmissionSimilarityMatch) so A-vs-B and
// B-vs-A never produce duplicate edges. eligibleForClustering is only
// ever true when independentFamilyCount >= the configured minimum AND
// combinedScore exceeds the versioned threshold — see
// src/lib/cohortCollusion/graph.ts. A single shared IP, one matching
// device identifier, one similarity score, or one timing event can never
// make an edge eligible on their own (each is exactly one family).
model CollusionPairEdge {
  id         String                  @id @default(cuid())
  analysisId String
  analysis   CohortCollusionAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  sourceSubmissionId   String
  sourceSubmission     Submission @relation("CollusionEdgeSource", fields: [sourceSubmissionId], references: [id], onDelete: Cascade)
  comparedSubmissionId String
  comparedSubmission   Submission @relation("CollusionEdgeCompared", fields: [comparedSubmissionId], references: [id], onDelete: Cascade)

  combinedScore           Float
  independentFamilyCount  Int
  eligibleForClustering   Boolean @default(false)
  // Per-family capped contribution to combinedScore — see
  // FAMILY_SCORE_CAPS in src/lib/cohortCollusionThresholds.ts. Keyed by
  // signal family (ANSWER_CONTENT | RARE_MISTAKE | MCQ_PATTERN |
  // TIMING_SYNCHRONISATION | SESSION_NETWORK_DEVICE | CROSS_EXAM_RECURRENCE).
  familyScoresJson Json?
  summaryJson      Json?

  createdAt DateTime @default(now())

  signals CollusionSignal[]

  @@unique([analysisId, sourceSubmissionId, comparedSubmissionId])
  @@index([analysisId])
  @@index([sourceSubmissionId])
  @@index([comparedSubmissionId])
}

// One explainable signal contributing to one edge. Multiple signals from
// the same underlying evidence (e.g. three answer-content metrics on the
// same pair of responses) still count as ONE independent family — see
// signalFamily below and src/lib/cohortCollusion/graph.ts,
// countIndependentFamilies(). evidenceJson stores only minimal explainable
// excerpts or hashes, never a full duplicated student answer — see
// docs/cohort-collusion-graph-v1.md, "Privacy controls".
model CollusionSignal {
  id     String            @id @default(cuid())
  edgeId String
  edge   CollusionPairEdge @relation(fields: [edgeId], references: [id], onDelete: Cascade)

  // ANSWER_CONTENT | RARE_MISTAKE | MCQ_PATTERN | TIMING_SYNCHRONISATION |
  // SESSION_NETWORK_DEVICE | CROSS_EXAM_RECURRENCE
  signalFamily String
  signalType   String
  score        Float
  confidence   Float
  explanation  String
  evidenceJson Json?

  createdAt DateTime @default(now())

  @@index([edgeId])
  @@index([signalFamily])
}

// A possible coordinated-answer cluster: a connected component of eligible
// edges that has survived the minimum-size, family-diversity, and
// weak-member-pruning rules in src/lib/cohortCollusion/graph.ts. Never a
// misconduct finding — concernLevel/reviewStatus are lecturer-review
// signals only. clusterKey is a stable, deterministic identifier derived
// from its (post-pruning) sorted member submission ids, so a re-run of
// the same underlying pattern updates the same row (carrying forward
// reviewStatus/reviewedAt/reviewedById/reviewNote) rather than creating a
// duplicate and losing review history — see
// docs/cohort-collusion-graph-v1.md, "Repeated analysis runs".
model CollusionCluster {
  id         String                  @id @default(cuid())
  analysisId String
  analysis   CohortCollusionAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  clusterKey             String
  memberCount            Int
  independentFamilyCount Int
  edgeCount              Int
  // NONE | WATCH | NEEDS_REVIEW | HIGHER_CONCERN — see
  // HIGHER_CONCERN_RULES in src/lib/cohortCollusionThresholds.ts.
  concernLevel String @default("NEEDS_REVIEW")
  // NEEDS_REVIEW | REVIEWED_NO_CONCERN | REVIEWED_CONCERN_REMAINS |
  // ORAL_VERIFICATION_REQUESTED | ESCALATED | RESOLVED
  reviewStatus String @default("NEEDS_REVIEW")

  summaryJson Json?

  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?     @relation("CollusionClusterReviewer", fields: [reviewedById], references: [id])
  reviewNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members CollusionClusterMember[]

  @@unique([analysisId, clusterKey])
  @@index([analysisId])
  @@index([reviewStatus])
  @@index([concernLevel])
}

// One student's membership in one possible coordinated-answer cluster.
// supportingEdgeCount/independentFamilyCount are the member's OWN support
// within the cluster (not the cluster's totals) — a member must never
// remain in a cluster on the strength of a single weak pair; see
// pruneUnsupportedMembers() in src/lib/cohortCollusion/graph.ts.
model CollusionClusterMember {
  id        String           @id @default(cuid())
  clusterId String
  cluster   CollusionCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)

  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  supportingEdgeCount    Int
  independentFamilyCount Int
  memberScore            Float

  createdAt DateTime @default(now())

  @@unique([clusterId, submissionId])
  @@index([clusterId])
  @@index([submissionId])
}

// Answer-Development Provenance v1 (additive, opt-in) — see
// docs/answer-development-provenance-v1.md. THIS IS PROCESS EVIDENCE, NOT
// A MISCONDUCT DETECTOR — "development checkpoint"/"process evidence",
// never "proof of cheating". Never stores individual keystrokes, scan
// codes, or clipboard content separately from what the student actually
// inserted into an authorised answer field — see that doc's threat model.
// Uses the existing AnswerActivityEvent for low-volume coarse activity
// (unchanged, not replaced); this model is for READABLE answer-version
// checkpoints only. Default OFF for every exam — see
// Submission.answerProvenancePolicySnapshotJson above; a null snapshot on
// a submission means no rows here were ever created for it.
model AnswerDevelopmentVersion {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  answerId     String
  answer       Answer     @relation(fields: [answerId], references: [id], onDelete: Cascade)
  questionId   String
  question     Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  // Server-assigned, sequential per (submissionId, questionId) — the
  // client never supplies or is trusted for this number (Part 6).
  versionNumber Int

  // The answer text AS IT EXISTED at this checkpoint. This is process
  // evidence of the student's own authorised answer content, not a
  // separate secret capture — the same text is (or will be) reflected in
  // Answer.response via the ordinary autosave path.
  responseText   String
  responseLength Int
  responseHash   String

  // Advisory pointer only (no FK, mirrors AnswerActivityEvent.previousEventId)
  // to the prior version for this question — used to compute diffs, never
  // used for cascade behaviour.
  previousVersionId String?

  // INITIAL_TEXT | PERIODIC_CHECKPOINT | SUBSTANTIAL_EDIT |
  // POST_PASTE_CHECKPOINT | PRE_SUBMISSION_CHECKPOINT | FINAL_SUBMISSION |
  // MANUAL_STUDENT_CHECKPOINT — validated string, not a Prisma enum,
  // following the SubmissionSimilarityAnalysis convention. See
  // src/lib/answerDevelopment.ts for the validator.
  changeType String

  charactersAdded   Int
  charactersRemoved Int
  /** Fraction of the prior version's length that changed, in [0, 1] (0 for INITIAL_TEXT). */
  changeRatio Float

  // AUTOSAVE | TIMER | PASTE | NAVIGATION | SUBMISSION | STUDENT_ACTION
  source String

  // Idempotency key (mirrors AiAssistanceInteraction/IntegrityEvidenceAsset
  // clientRequestId precedent) — nullable with a unique index; a retried/
  // duplicated checkpoint request is recognised and replayed instead of
  // consuming a second version-number slot.
  clientRequestId String? @unique

  // Server-received timestamp is authoritative; clientElapsedMs is
  // supplementary only (Part 3/4) — mirrors AnswerActivityEvent exactly.
  serverReceivedAt DateTime @default(now())
  clientElapsedMs  Int?

  createdAt DateTime @default(now())

  @@unique([submissionId, questionId, versionNumber])
  @@index([submissionId])
  @@index([answerId])
  @@index([questionId])
  @@index([submissionId, questionId])
}

// Structured process metadata that does not require a full readable
// version — see docs/answer-development-provenance-v1.md. No event here
// is itself labelled misconduct; eventLevel is INFORMATIONAL/CONTEXT/
// REVIEW_CONTEXT, never a risk score.
model AnswerDevelopmentEvent {
  id                   String              @id @default(cuid())
  submissionId         String
  submission           Submission          @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  answerId             String?
  answer               Answer?             @relation(fields: [answerId], references: [id], onDelete: SetNull)
  questionId           String?
  question             Question?           @relation(fields: [questionId], references: [id], onDelete: SetNull)
  examAttemptSessionId String?
  examAttemptSession   ExamAttemptSession? @relation(fields: [examAttemptSessionId], references: [id], onDelete: SetNull)

  // FIRST_KEYSTROKE | FIRST_MEANINGFUL_TEXT | SUBSTANTIAL_EDIT |
  // LARGE_DELETION | MAJOR_REWRITE | PASTE_ATTEMPT_BLOCKED | PASTE_INSERTED |
  // PASTED_TEXT_SUBSTANTIALLY_REPLACED | OUTLINE_CREATED | OUTLINE_UPDATED |
  // CALCULATION_WORKING_CREATED | CALCULATION_WORKING_UPDATED |
  // CODE_WORKING_CREATED | CODE_WORKING_UPDATED | CODE_RUN_REQUESTED |
  // CODE_RUN_COMPLETED | CODE_RUN_FAILED | TEST_RUN_COMPLETED |
  // SOURCE_DECLARATION_CREATED | SOURCE_DECLARATION_UPDATED |
  // FINAL_ANSWER_SUBMITTED — see src/lib/answerDevelopment.ts.
  eventType String
  // INFORMATIONAL | CONTEXT | REVIEW_CONTEXT — never MISCONDUCT/VIOLATION.
  eventLevel String

  clientRequestId String? @unique

  serverReceivedAt DateTime @default(now())
  clientElapsedMs  Int?

  // Tightly-validated, bounded metadata only (Part 11) — never arbitrary
  // unlimited JSON; see ANSWER_DEVELOPMENT_EVENT_METADATA_MAX_BYTES in
  // src/lib/answerDevelopmentThresholds.ts and the validator in
  // src/lib/answerDevelopment.ts. Never a raw clipboard field, never
  // individual keystrokes.
  metadataJson Json?

  createdAt DateTime @default(now())

  @@index([submissionId])
  @@index([answerId])
  @@index([questionId])
  @@index([examAttemptSessionId])
  @@index([eventType])
  @@index([serverReceivedAt])
}

// Structured student working associated with one answer (outline,
// calculation working, code working, or a source/AI-use declaration) —
// see docs/answer-development-provenance-v1.md. One CURRENT row per
// (submission, question-or-null, artifactType); questionId is nullable
// because AI_SOURCE_DECLARATION/GENERAL_SOURCE_DECLARATION are attempt-
// level, not per-question (see that doc, "Sources and AI declaration").
// Historical versions are preserved in AnswerDevelopmentArtifactVersion
// below — updating this row never silently discards prior working.
// Student-authored content is private assessment data: students can read
// only their own current attempt; lecturers can read only authorised
// submissions within their institution (enforced in the API routes, not
// the schema).
model AnswerDevelopmentArtifact {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  answerId     String?
  answer       Answer?    @relation(fields: [answerId], references: [id], onDelete: SetNull)
  questionId   String?
  question     Question?  @relation(fields: [questionId], references: [id], onDelete: SetNull)

  // OUTLINE | CALCULATION_WORKING | CODE_WORKING | AI_SOURCE_DECLARATION |
  // GENERAL_SOURCE_DECLARATION
  artifactType String

  // Bounded per type — see ARTIFACT_MAX_CHARACTERS in
  // src/lib/answerDevelopmentThresholds.ts (e.g. outline 20,000 chars,
  // code working 100,000 chars). Plain text/structured text only — never
  // unsafe HTML rendering (Part 5).
  content     String
  contentHash String

  // Current version number — increments on every update; full history in
  // AnswerDevelopmentArtifactVersion, never silently overwritten.
  version Int @default(1)

  clientRequestId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions AnswerDevelopmentArtifactVersion[]

  // Part 3 hardening (see docs/answer-development-provenance-v1-migration.sql)
  // — real uniqueness is enforced at the DATABASE level by two partial
  // unique indexes keyed on `answerId` (the actual discriminator, not
  // `questionId`), NOT representable in Prisma's schema DSL (partial/
  // filtered unique indexes have no `@@unique` equivalent here) and so
  // deliberately absent from this model as a `@@unique` line:
  //   AnswerDevelopmentArtifact_answer_type_key
  //     ON ("answerId", "artifactType") WHERE "answerId" IS NOT NULL
  //   AnswerDevelopmentArtifact_submission_type_key
  //     ON ("submissionId", "artifactType") WHERE "answerId" IS NULL
  // Every per-question artifact type (OUTLINE/CALCULATION_WORKING/
  // CODE_WORKING) is guaranteed a real, non-null `answerId` before this
  // row is created (see upsertAnswerDevelopmentArtifact in
  // src/lib/answerDevelopmentRunner.ts, which upserts the Answer row
  // first); attempt-level source declarations always have `answerId:
  // null`. Because the partitioned columns (`submissionId`/`artifactType`)
  // are themselves never null, Postgres's "NULL is distinct" rule for
  // plain unique indexes does not apply here — both indexes are fully
  // enforcing, not an application-level-only guarantee. Application code
  // additionally handles a `P2002` unique-violation race (two concurrent
  // writes) by recovering into an update rather than relying on a
  // pre-check alone — see that same file.
  @@index([submissionId])
  @@index([answerId])
  @@index([questionId])
}

// Readable version history for AnswerDevelopmentArtifact — see
// docs/answer-development-provenance-v1.md. One row per historical
// version; the CURRENT version's content also lives denormalised on the
// parent AnswerDevelopmentArtifact row for cheap reads.
model AnswerDevelopmentArtifactVersion {
  id         String                    @id @default(cuid())
  artifactId String
  artifact   AnswerDevelopmentArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  versionNumber Int
  content       String
  contentHash   String

  clientRequestId String? @unique

  createdAt DateTime @default(now())

  @@unique([artifactId, versionNumber])
  @@index([artifactId])
}

// Code-execution event contract — see docs/answer-development-provenance-v1.md
// ("Code-run limitation"). No secure isolated code runner exists in this
// repo/environment, so v1 NEVER executes student code inside the Next.js/
// Vercel application process and NEVER fabricates a pass/fail result.
// Every row this feature actually writes in v1 has exitStatus
// "NOT_CONFIGURED" — this model exists to give the code-working editor's
// "Run code" contract a real, typed, persisted shape (request received,
// clearly reported as unavailable) so a future isolated runner can be
// wired in later without a schema change. Never stores unrestricted
// terminal output — outputSummaryJson is bounded (see
// src/lib/answerDevelopmentThresholds.ts).
model CodeExecutionEvent {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  answerId     String?
  answer       Answer?    @relation(fields: [answerId], references: [id], onDelete: SetNull)
  questionId   String
  question     Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  clientRequestId String? @unique

  // RUN | TEST — see src/lib/answerDevelopment.ts.
  runType  String
  language String?

  codeHash   String
  codeLength Int

  testSetIdentifier String?
  testsRun          Int?
  testsPassed       Int?
  testsFailed       Int?

  // NOT_CONFIGURED in v1 (always) — reserved values PASSED/FAILED/ERROR/
  // TIMEOUT for a future real runner; never written by v1.
  exitStatus String
  durationMs Int?

  // Bounded, structured summary only — never raw/unrestricted terminal
  // output (Part 2).
  outputSummaryJson Json?

  serverReceivedAt DateTime @default(now())
  createdAt        DateTime @default(now())

  @@index([submissionId])
  @@index([answerId])
  @@index([questionId])
}

// ---------------------------------------------------------------------------
// Tether Secure Client Foundation + Safe Exam Browser Compatibility v1
// (additive, opt-in) — see docs/secure-client-foundation-seb-v1.md. THIS
// PHASE DOES NOT BUILD THE PRODUCTION WINDOWS DESKTOP CLIENT — see
// docs/tether-secure-client-windows-architecture.md for that contract.
// The web examination platform remains fully functional without SEB or a
// future Tether client — deliveryMode defaults to STANDARD_WEB
// everywhere (src/lib/secureClientPolicy.ts). Every status/type/level
// field below is a validated plain String column, not a Prisma enum,
// following the SubmissionSimilarityAnalysis convention — validators
// live in src/lib/secureClientPolicy.ts and src/lib/secureClient/*.ts.
// institutionId/examId/studentId are plain scoping columns (not
// navigated Prisma relations) on the lower-level event/session models,
// mirroring NetworkEvidence.institutionId/IntegrityEvidenceAsset.
// institutionId above — kept for fast tenant-scoped queries without
// forcing every read through a join.
// ---------------------------------------------------------------------------

// One exam-level compatible-client configuration (SEB or a future Tether
// client). Only one ACTIVE configuration may exist per (examId, provider)
// — enforced by a partial unique index in
// docs/secure-client-foundation-seb-v1-migration.sql (not representable
// as a plain Prisma `@@unique`, same reasoning as
// AnswerDevelopmentArtifact's partial indexes — see that model's
// comment). `configurationHash` is set once, at activation, and never
// changed afterward — activated records may be REVOKED but never
// silently edited; a genuine change requires a new DRAFT configuration
// version.
model SecureClientConfiguration {
  id            String @id @default(cuid())
  institutionId String
  examId        String
  exam          Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)

  // SAFE_EXAM_BROWSER | TETHER_SECURE_CLIENT
  provider String
  // DRAFT | ACTIVE | REVOKED | ARCHIVED
  status String @default("DRAFT")

  displayName          String?
  configurationVersion Int     @default(1)
  // Immutable once status becomes ACTIVE — see
  // src/lib/secureClient/secureClientConfigRunner.ts.
  configurationHash String?

  startUrlTemplate String?
  quitUrlTemplate  String?
  allowedOriginsJson   Json?
  allowedPlatformsJson Json?
  minimumVersionsJson  Json?
  // Bounded, allowlisted settings only — never arbitrary JSON accepted
  // from a client; see the strict schema in src/lib/secureClientPolicy.ts.
  settingsJson Json?

  createdById   String
  createdBy     User      @relation("SecureClientConfigCreatedBy", fields: [createdById], references: [id])
  activatedById String?
  activatedBy   User?     @relation("SecureClientConfigActivatedBy", fields: [activatedById], references: [id])
  activatedAt   DateTime?
  revokedById   String?
  revokedBy     User?     @relation("SecureClientConfigRevokedBy", fields: [revokedById], references: [id])
  revokedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sebAllowedExamKeys SebAllowedExamKey[]
  launchManifests    SecureClientLaunchManifest[]
  sessions           SecureClientSession[]

  @@index([examId])
  @@index([institutionId])
  @@index([status])
}

// Allowed Safe Exam Browser validation keys for one configuration — see
// docs/secure-client-foundation-seb-v1.md ("Browser Exam Key
// validation"). Only a normalised SHA-256 hash is ever stored; the raw
// key value is never persisted, logged, or returned to any client
// (student or lecturer) after entry — see
// src/lib/secureClient/sebBrowserExamKey.ts.
model SebAllowedExamKey {
  id              String                    @id @default(cuid())
  configurationId String
  configuration   SecureClientConfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)

  // BROWSER_EXAM_KEY | CONFIG_KEY
  keyType String
  // SHA-256 hex digest of the normalised raw key — used for lookup,
  // deduplication (see @@unique below), and the masked fingerprint shown
  // in the lecturer UI (Part 11). Never sufficient on its own to verify a
  // request.
  keyHash String

  // Deliberate, documented addition beyond the task's literal field list
  // (justified under "Names may be adjusted... but preserve
  // responsibilities" for Part 3): the official SEB request-hash protocol
  // is expectedHash = SHA256(requestUrl + rawKey) — verifying an incoming
  // request cryptographically requires the RAW key at verification time;
  // a one-way hash of the key alone cannot support this (SHA-256 is not
  // invertible). rawKeyCiphertext stores the raw key AES-256-GCM-encrypted
  // as `scv1:<keyId>:<ivHex>:<authTagHex>:<ciphertextHex>` — an explicit
  // format version and key id support rotation via the server-only
  // TETHER_SEB_KEY_ENCRYPTION_KEYS_JSON / _ACTIVE_KEY_ID env vars (never
  // committed, never a runtime-generated fallback — missing/malformed
  // configuration fails closed) — see
  // src/lib/secureClient/sebKeyEncryption.ts. Never selected in any
  // student- or lecturer-facing API response, never logged. See
  // docs/secure-client-foundation-seb-v1.md, "Known limitations", for the
  // full rationale and the recommended KMS-backed hardening path.
  rawKeyCiphertext String?

  platform      String?
  clientVersion String?
  label         String?

  active Boolean @default(true)

  createdById String
  createdBy   User      @relation("SebAllowedExamKeyCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  @@unique([configurationId, keyType, keyHash])
  @@index([configurationId])
  @@index([keyType])
  @@index([active])
}

// One short-lived, single-use secure launch — see
// docs/secure-client-foundation-seb-v1.md ("Signed secure-launch
// manifest"). The raw launch nonce is NEVER stored — only nonceHash
// (Part 6/14: "store only a cryptographic hash of the nonce"). Not a
// reusable general-purpose exam token: bound to institution, exam,
// submission, student, policy (policyHash), and client type all at once.
model SecureClientLaunchManifest {
  id            String @id @default(cuid())
  institutionId String
  examId        String
  exam          Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  submissionId  String
  submission    Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  studentId     String

  configurationId String?
  configuration   SecureClientConfiguration? @relation(fields: [configurationId], references: [id], onDelete: SetNull)

  // SAFE_EXAM_BROWSER | TETHER_SECURE_CLIENT | MOCK_TETHER_CLIENT
  clientType String

  nonceHash    String @unique
  policyHash   String
  manifestHash String

  issuedAt   DateTime  @default(now())
  expiresAt  DateTime
  consumedAt DateTime?
  revokedAt  DateTime?

  // Advisory pointer only (no FK) to the SecureClientSession this launch
  // produced, once consumed — mirrors AnswerActivityEvent.previousEventId.
  clientSessionId String?

  createdAt DateTime @default(now())

  @@index([submissionId])
  @@index([examId])
  @@index([institutionId])
  @@index([expiresAt])
}

// One verified or attempted secure-client session per submission — see
// docs/secure-client-foundation-seb-v1.md ("Session state machine").
// `clientInstallationIdHash` is a random, hashed, per-installation
// identifier — never a hardware serial number, MAC address, or
// unrestricted machine fingerprint (Part 3). As of Secure Client
// Attestation v2 (docs/tether-system-check-v1.md), this field is
// populated with a registered TetherClientInstallation's
// `publicKeyFingerprint` whenever a genuine EXAM_SESSION installation
// attestation succeeds for this session (see
// recordInstallationBoundExamAttestation in
// systemCheckSecureClientRunner.ts) — additive, alongside the existing
// verificationStatus/status fields, which still govern this session's
// actual READY/CANNOT_START outcome unchanged in this pass (see "Known
// limitations" — full enforcement gating on this field is a follow-up).
// Only one CURRENT non-terminal session per submission is allowed —
// enforced by a partial unique index in the migration (WHERE status NOT
// IN ('ENDED', 'REJECTED')), so a browser refresh never silently creates
// a second session; recovery/end must be explicit.
model SecureClientSession {
  id            String @id @default(cuid())
  institutionId String
  examId        String
  exam          Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  submissionId  String
  submission    Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  studentId     String

  configurationId String?
  configuration   SecureClientConfiguration? @relation(fields: [configurationId], references: [id], onDelete: SetNull)

  // SAFE_EXAM_BROWSER | TETHER_SECURE_CLIENT | MOCK_TETHER_CLIENT
  clientType String
  // CREATED | PREFLIGHT | ACTIVE | INTERRUPTED | RECOVERY_REQUIRED | ENDED | REJECTED
  status String @default("CREATED")
  // NOT_CHECKED | VERIFIED | INVALID_CONFIGURATION | UNSUPPORTED_VERSION |
  // UNVERIFIED_CLIENT | EXPIRED_LAUNCH | REPLAY_REJECTED |
  // TECHNICAL_FAILURE | LECTURER_OVERRIDE
  verificationStatus String @default("NOT_CHECKED")

  platform                 String?
  clientVersion            String?
  clientInstallationIdHash String?
  policyHash               String?

  // Secure Client Attestation v2 — EXAM_SESSION wiring. `clientInstallationId`
  // is the real reference (advisory relation, onDelete: SetNull — a later
  // installation revocation/replacement must never retroactively alter
  // historical session evidence). `installationAttestationVerified` is the
  // v2 verification OUTCOME for this session, populated ONLY by
  // verifyExamSessionAttestation after all 20 required checks pass — see
  // tetherAttestationRunner.ts. This is deliberately a SEPARATE field from
  // `verificationStatus`/`status` (the legacy fields), never overwritten by
  // them and never overwriting them: whether v2 verification actually
  // gates exam content access is decided at request time by
  // resolveEffectiveTetherVerification (src/lib/secureClient/examAttestationMode.ts),
  // according to TETHER_EXAM_ATTESTATION_MODE — not by any column here.
  clientInstallationId               String?
  clientInstallation                 TetherClientInstallation? @relation(fields: [clientInstallationId], references: [id], onDelete: SetNull)
  installationAttestationVerified    Boolean                   @default(false)
  installationAttestationVerifiedAt  DateTime?
  // Last v2 verification failure's reason code, if any — cleared to null on
  // the next success. Never a stack trace or raw request body; always one
  // of the ValidationReasonCode / VerifyExamSessionAttestationResult
  // outcome strings.
  installationAttestationFailureReason String?
  // Advisory pointer (no FK, mirrors clientInstallationIdHash's own
  // pattern) to the SystemCheckSecureClientVerification row holding the
  // full evidence record (clientVersion, platform,
  // displayTopologyClassification, nonceHash, challengeHash, verifiedAt)
  // for the latest successful v2 EXAM_SESSION attestation.
  installationVerificationId String?

  // Pre-Preview safety pass — see docs/tether-system-check-v1.md,
  // "Immutable per-session attestation requirement". The resolved
  // TETHER_EXAM_ATTESTATION_MODE (LEGACY | DUAL | V2_REQUIRED), snapshotted
  // ONCE by getOrCreateSessionCore at the moment this session is first
  // created — server-computed from the environment resolver only, NEVER
  // from any client-supplied value (in particular, never from the
  // unsigned, renderer-controlled `clientVersion` field above). Read by
  // resolveEffectiveTetherVerification() at every subsequent request
  // instead of recomputing from the live environment variable, so (a) a
  // later environment-variable change can never retroactively alter an
  // already-in-progress session's access contract, and (b) DUAL's
  // "legacy AND v2 both required" requirement can never be
  // self-downgraded by a client claiming an older version. NULL for any
  // session created before this column existed — treated as "LEGACY" by
  // every reader (the safe, pre-v2 default), never re-derived from the
  // current environment.
  attestationRequirement String?

  manifestId String? @unique

  startedAt        DateTime  @default(now())
  verifiedAt       DateTime?
  lastHeartbeatAt  DateTime?
  interruptedAt    DateTime?
  recoveredAt      DateTime?
  endedAt          DateTime?
  endReason        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attestations    SecureClientAttestation[]
  events          SecureClientEvent[]
  recoveryGrants  SecureClientRecoveryGrant[]

  @@index([submissionId])
  @@index([examId])
  @@index([institutionId])
  @@index([status])
  @@index([studentId])
  @@index([clientInstallationId])
}

// One structured preflight/client-verification result — see
// docs/secure-client-foundation-seb-v1.md ("Attestation and preflight").
// `detailsJson` uses a strict per-check schema (Part 3/14) — never
// arbitrary JSON, never a full process list, never command-line
// arguments, never open-document names, never window titles. Prohibited-
// process evidence (when present) contains only a configured rule
// identifier, matched category, a normalised application identifier, and
// a timestamp — see src/lib/secureClient/attestation.ts.
model SecureClientAttestation {
  id                    String              @id @default(cuid())
  secureClientSessionId String
  session               SecureClientSession @relation(fields: [secureClientSessionId], references: [id], onDelete: Cascade)

  attestationVersion String @default("v1")
  // SAFE_EXAM_BROWSER | TETHER_SECURE_CLIENT | MOCK_TETHER_CLIENT
  clientType String
  platform      String?
  osVersion     String?
  clientVersion String?
  clientBuild   String?

  // Every *Status field below: PASS | FAIL | WARNING | NOT_CHECKED |
  // NOT_SUPPORTED | UNKNOWN — see src/lib/secureClient/attestation.ts.
  clientSignatureStatus            String?
  configurationVerificationStatus  String?
  displayCount                     Int?
  displayCheckStatus               String?
  remoteSessionStatus              String?
  virtualMachineStatus             String?
  processCheckStatus               String?
  captureProtectionStatus          String?
  clipboardPolicyStatus            String?
  printingPolicyStatus             String?
  externalNavigationPolicyStatus   String?

  // READY | ACTION_REQUIRED | CANNOT_START | NOT_SUPPORTED | TECHNICAL_FAILURE
  overallStatus String

  detailsJson Json?

  clientReportedAt DateTime?
  serverReceivedAt DateTime  @default(now())
  createdAt        DateTime  @default(now())

  @@index([secureClientSessionId])
  @@index([overallStatus])
  @@index([serverReceivedAt])
}

// Structured client/session integrity signal — see
// docs/secure-client-foundation-seb-v1.md ("Integrity events"). NO EVENT
// IS ITSELF LABELLED MISCONDUCT — eventLevel is INFORMATIONAL/CONTEXT/
// ACTION_REQUIRED/REVIEW_CONTEXT, never a violation score. Strict
// per-eventType metadata schema — see
// src/lib/secureClient/secureClientEvents.ts (mirrors
// DEVELOPMENT_EVENT_METADATA_SCHEMAS in src/lib/answerDevelopment.ts).
model SecureClientEvent {
  id                    String               @id @default(cuid())
  secureClientSessionId String?
  session               SecureClientSession? @relation(fields: [secureClientSessionId], references: [id], onDelete: SetNull)
  submissionId          String
  submission            Submission           @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  examId                String
  institutionId         String

  eventType String
  // INFORMATIONAL | CONTEXT | ACTION_REQUIRED | REVIEW_CONTEXT
  eventLevel String

  clientRequestId String? @unique
  // Server-assigned and checked, never trusted from the client as
  // authoritative on its own — see src/lib/secureClient/secureClientEvents.ts.
  sequenceNumber  Int?
  clientElapsedMs Int?

  serverReceivedAt DateTime @default(now())
  metadataJson     Json?

  createdAt DateTime @default(now())

  @@index([secureClientSessionId])
  @@index([submissionId])
  @@index([examId])
  @@index([institutionId])
  @@index([eventType])
  @@index([serverReceivedAt])
}

// One lecturer-issued, one-time recovery credential for an interrupted
// secure-client session — see docs/secure-client-foundation-seb-v1.md
// ("Recovery"). Only a hash of the grant code/token is ever stored
// (Part 3/14) — never the raw value after issuance. `reason` is always
// lecturer-supplied and audited (also written to PlatformAuditLog by the
// issuing route).
model SecureClientRecoveryGrant {
  id                    String              @id @default(cuid())
  secureClientSessionId String
  session               SecureClientSession @relation(fields: [secureClientSessionId], references: [id], onDelete: Cascade)
  submissionId          String
  submission            Submission          @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  grantCodeHash String @unique

  issuedById String
  issuedBy   User     @relation("SecureClientRecoveryGrantIssuedBy", fields: [issuedById], references: [id])
  issuedAt   DateTime @default(now())
  expiresAt  DateTime
  consumedAt DateTime?
  revokedAt  DateTime?

  reason String

  createdAt DateTime @default(now())

  @@index([secureClientSessionId])
  @@index([submissionId])
  @@index([expiresAt])
}

// Tether System Check and Exam Readiness v1 (additive) — see
// docs/tether-system-check-v1.md. One row per completed "Check this
// computer" run. This is a TECHNICAL READINESS record, not an integrity
// signal — never joined against or interpreted as misconduct evidence,
// and never itself a source of exam-content authorization (the real
// exam-start preflight and verified secure-client session checks always
// run again — see src/lib/systemCheck/readiness.ts). `secureClientSessionId`
// is an advisory pointer only (no FK), mirroring
// SecureClientLaunchManifest.clientSessionId above — a system check runs
// standalone, outside any submission, so there is usually no session to
// point at. `resultsJson` holds one bounded {status, reasonCode} object
// per check id (see SYSTEM_CHECK_IDS in readiness.ts) — never an image,
// audio sample, raw permission object, biometric template, or full
// launch manifest.
model TetherSystemCheckRun {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // READY | READY_WITH_WARNINGS | NOT_READY
  overallStatus String
  // BROWSER | TETHER_SECURE_CLIENT
  sourceClientType String

  clientVersion          String?
  operatingSystem        String?
  operatingSystemVersion String?

  // Advisory only — see doc comment above.
  secureClientSessionId String?

  checkedAt DateTime @default(now())
  expiresAt DateTime

  resultsJson Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, checkedAt])
  @@index([userId, expiresAt])
  @@index([secureClientSessionId])
}

// Tether System Check and Exam Readiness — Secure Client Attestation v2
// (see docs/tether-system-check-v1.md, "Secure Client Attestation v2").
// A SYSTEM_CHECK-scoped, single-use, signed verification. As of v2, this
// REQUIRES a genuine per-installation attestation (`installationId`,
// below) — the earlier v1 design (a single Ed25519 key compiled into
// every packaged build) has been REMOVED entirely: it allowed one
// extracted key to forge attestations for every installation. See git
// history for the removed `clientAttestationKey.ts` /
// `systemCheckClientAttestation.ts`. DELIBERATELY a separate, standalone
// model rather than a nullable-submissionId variant of
// SecureClientSession: nothing in the exam start/launch/attestation code
// path (secureClientRunner.ts, secureClientStartGate.ts,
// POST /api/exams/[id]/start, GET /api/submissions/[id]) ever reads this
// table, so there is no code path by which a SYSTEM_CHECK verification
// could ever be mistaken for, or accepted as, exam-launch authorization —
// a structural guarantee, not merely a convention. `purpose` is always
// "SYSTEM_CHECK" but kept as an explicit column (not inferred from the
// table's mere existence) so it states its own scope for audit, exactly
// mirroring the "EXAM_SESSION" purpose used elsewhere in the same
// attestation framework (src/lib/secureClient/tetherAttestation.ts).
model SystemCheckSecureClientVerification {
  id            String @id @default(cuid())
  userId        String
  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  institutionId String

  purpose String @default("SYSTEM_CHECK")

  // The attestation protocol version (AttestationChallenge.schemaVersion)
  // this row was verified under — evidence only; there is no server code
  // path that issues or accepts anything other than the current
  // ATTESTATION_PROTOCOL_VERSION today, but retaining it lets a future
  // protocol bump be told apart from older rows without guessing.
  attestationProtocolVersion Int @default(2)

  // The specific TetherClientInstallation that produced this
  // attestation — required (never null) as of v2: every SYSTEM_CHECK
  // verification must be traceable to one genuine, registered,
  // currently-ACTIVE installation. No FK (mirrors the advisory-pointer
  // convention already used elsewhere in this schema) so a later
  // installation revocation/replacement never needs to touch historical
  // verification rows.
  installationId String

  // TETHER_SECURE_CLIENT | MOCK_TETHER_CLIENT
  clientType String
  // NOT_CHECKED | VERIFIED | INVALID_SIGNATURE | EXPIRED | REPLAY_REJECTED | WRONG_SUBJECT | WRONG_PURPOSE | INSTALLATION_NOT_ACTIVE | UNSUPPORTED_VERSION | TECHNICAL_FAILURE
  verificationStatus String @default("NOT_CHECKED")

  clientVersion String?
  platform      String?
  // The AUTHORITATIVE, installation-signature-bound native display-
  // topology classification gathered by the Electron main process
  // itself (never a value the renderer could tamper with independently
  // — see verifyInstallationSignature in tetherAttestation.ts). One of
  // DISPLAY_TOPOLOGY_CLASSIFICATIONS in readiness.ts.
  displayTopologyClassification String?

  // Replay protection — a second verify attempt with the same nonce
  // fails the unique constraint outright (see systemCheckSecureClientRunner.ts).
  nonceHash     String @unique
  challengeHash String

  issuedAt   DateTime
  expiresAt  DateTime
  verifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@index([installationId])
}

// Pre-Preview safety pass — see docs/tether-system-check-v1.md,
// "Single-use registration challenges". Records ONLY the atomic
// CONSUMPTION of a registration challenge — never written at challenge
// issuance time (that step is deliberately stateless, matching every
// other short-lived signed challenge in this codebase). A row here
// exists if and only if a registration challenge for this exact nonce
// was successfully consumed; a second attempt with the same nonce fails
// the unique constraint on nonceHash outright (registerInstallation
// inserts this row inside the SAME transaction as creating the
// TetherClientInstallation — both succeed together or neither does).
// Deliberately minimal: no public key, no signature, no reusable token —
// only enough to prove/audit that this specific challenge was consumed,
// by whom, and for which key fingerprint.
model TetherInstallationRegistrationChallenge {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  publicKeyFingerprint String
  nonceHash            String   @unique
  consumedAt           DateTime @default(now())
  createdAt            DateTime @default(now())

  @@index([userId, createdAt])
}

// Secure Client Attestation v2 — see docs/tether-system-check-v1.md,
// "Per-installation key" and "Installation registration". One row per
// registered Tether Secure Browser installation, each with its OWN
// Ed25519 (or, for a future TPM/CNG-backed installation, ECDSA P-256)
// keypair — the PRIVATE half never leaves that one installation's own
// device (see apps/lockdown/src/installationKey.ts). Replaces the v1
// design's single, globally-shared, compiled-in private key: compromise
// of any ONE installation's key here only ever affects that one
// installation, which can be revoked independently without touching any
// other student's ability to attest.
//
// `keyProtectionLevel` is SELF-REPORTED by the client at registration
// time and is NEVER escalated by the server beyond what it can actually
// verify: this release's Electron code only ever produces
// "SOFTWARE_PROTECTED" (an Ed25519 key generated by Node's `crypto` and
// encrypted at rest via Electron's OS-backed `safeStorage`, e.g. Windows
// DPAPI) — "TPM_UNATTESTED" and "TPM_ATTESTED" are structurally
// supported here for a FUTURE pass that adds real Windows CNG/TPM key
// storage and (for TPM_ATTESTED specifically) genuine remote attestation
// evidence verification, neither of which exists yet — see "Known
// limitations" in the doc above. The registration route explicitly
// REJECTS any client-claimed "TPM_ATTESTED" value today, since no
// evidence-verification code exists to substantiate that claim.
model TetherClientInstallation {
  id            String @id @default(cuid())
  userId        String
  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  institutionId String

  publicKey            String
  publicKeyFingerprint String @unique
  // "Ed25519" today; "ECDSA_P256" reserved for a future TPM/CNG-backed installation.
  keyAlgorithm String
  // SOFTWARE_PROTECTED | TPM_UNATTESTED | TPM_ATTESTED — see doc comment above.
  keyProtectionLevel String @default("SOFTWARE_PROTECTED")

  clientVersion String?
  platform      String?

  // ACTIVE | REVOKED | REPLACED — up to
  // resolveMaxActiveInstallationsPerUser() (see tetherAttestationConfig.ts,
  // default 2) installations may be ACTIVE per user at once (multi-device
  // support). Registering beyond that limit is REJECTED (LIMIT_REACHED),
  // never silently marks anything REPLACED — REPLACED is retained in the
  // enum for backward-compatible reads only; no live code path writes it
  // as of this pass. The student's own self-service revoke action (or an
  // administrator/security-review action) sets REVOKED with a reason
  // instead — see tetherAttestationRunner.ts.
  status String @default("ACTIVE")

  // Advisory inverse side of SecureClientSession.clientInstallationId —
  // every real exam session this installation ever produced a verified
  // v2 EXAM_SESSION attestation for. Read-only evidence trail; revoking
  // or replacing this installation never touches these historical rows.
  secureClientSessions SecureClientSession[]

  installedAt      DateTime  @default(now())
  lastAttestedAt   DateTime?
  revokedAt        DateTime?
  revocationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, publicKeyFingerprint])
  @@index([userId, status])
}
