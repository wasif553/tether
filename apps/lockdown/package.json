{
  "name": "ses-lockdown",
  "version": "1.2.0",
  "private": true,
  "description": "Tether Secure Browser v1.2 (secure exam client with launch/install flow, live single-display enforcement including Windows Duplicate/Clone detection, and face-visibility false-positive fixes for Safe Exam System)",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.0",
    "vitest": "^4.1.9"
  }
}
